---
import '@styles/global.css';
import FloatingActions from '@components/FloatingActions.astro';
import SiteFooter from '@components/SiteFooter.astro';
import SiteHeader from '@components/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  variant?: 'light' | 'dark';
  canonical?: string;
  robots?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  category?: string;
  tags?: string[];
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'Clash机场评测导航 | 2026 IPLC/IEPL专线测速与42家机场品牌库',
  description = 'clashjichang.world 收录42家主流机场品牌真实参数、16+份节点测速报告与全平台客户端下载指南。第一主推光速云IEPL专线，月均低至8元起。',
  image = '/og-default.svg',
  variant = 'light',
  canonical,
  robots = 'index, follow',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author,
  category,
  tags = [],
  schema
} = Astro.props;

const rawCanonical = canonical || new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const canonicalUrl = rawCanonical.replace(/\/$/, '') || 'https://clashjichang.world';
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;

// Search Engine Webmaster Verification Meta Tags (Static HTML output when configured)
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const shenmaVerification = import.meta.env.PUBLIC_SHENMA_SITE_VERIFICATION;
const baiduVerification = import.meta.env.PUBLIC_BAIDU_SITE_VERIFICATION;
const analyticsId = import.meta.env.PUBLIC_GA_ID;

// Base WebSite + Organization Schema
const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Clash机场',
    url: 'https://clashjichang.world',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://clashjichang.world/brands?q={search_term_string}',
      'query-input': 'required name=search_term_string'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Clash机场',
    url: 'https://clashjichang.world',
    logo: 'https://clashjichang.world/favicon.svg'
  }
];

const allSchemas = schema
  ? Array.isArray(schema)
    ? [...baseSchema, ...schema]
    : [...baseSchema, schema]
  : baseSchema;
---
<!doctype html>
<html lang="zh-CN" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="applicable-device" content="pc,mobile" />
    <meta http-equiv="Cache-Control" content="no-transform" />
    <meta http-equiv="Cache-Control" content="no-siteapp" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="https://clashjichang.world/sitemap.xml" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Clash机场" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    {category && <meta property="article:section" content={category} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Search Engine Webmaster Verification Slots (Google / Bing / Shenma / Baidu) -->
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    {shenmaVerification && <meta name="shenma-site-verification" content={shenmaVerification} />}
    {baiduVerification && <meta name="baidu-site-verification" content={baiduVerification} />}

    <!-- Google Analytics (Optional) -->
    {analyticsId && <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>}
    {analyticsId && (
      <script is:inline define:vars={{ analyticsId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', analyticsId, { anonymize_ip: true });
      </script>
    )}

    <!-- JSON-LD Structured Data for SEO / GEO -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <div class="flex min-h-screen flex-col bg-paper dark:bg-night text-ink dark:text-gray-100 transition-colors">
      <SiteHeader variant={variant} />
      <main class={`relative flex flex-grow flex-col ${variant === 'dark' ? 'page-main-dark' : ''}`}>
        <slot />
        <FloatingActions />
      </main>
      <SiteFooter variant={variant} />
    </div>
  </body>
</html>
