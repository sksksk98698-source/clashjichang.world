---
import BaseLayout from '@layouts/BaseLayout.astro';
import BrandCard from '@components/BrandCard.astro';
import brandsData from '../../data/brands.json';

const allBrands = brandsData;
const top10 = allBrands.slice(0, 10);
const budgetBrands = allBrands.filter((b) => parseFloat(b.priceStr.match(/\d+(\.\d+)?/)?.[0] || '99') <= 10).slice(0, 6);
const ieplBrands = allBrands.filter((b) => b.lineType.includes('IEPL') || b.lineType.includes('IPLC')).slice(0, 6);

const pageTitle = '2026 Clash 机场排行榜 | Top 10 高速专线与高性价比机场推荐 - clashjichang.world';
const pageDesc = '2026 年度机场权威排行榜：第一主推光速云（IEPL双专线）、暮光加速、飞猫云、微风网络、大佬云等前十梯队。涵盖便宜性价比、晚高峰不卡顿及外贸专线细分榜单。';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://clashjichang.world' },
    { '@type': 'ListItem', position: 2, name: 'Top 10 推荐榜', item: 'https://clashjichang.world/ranking' }
  ]
};

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  url: 'https://clashjichang.world/ranking',
  description: pageDesc
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  schema={[breadcrumbSchema, collectionPageSchema]}
>
  <div class="border-b border-line dark:border-white/10 bg-paper/50 dark:bg-black/20 py-3">
    <div class="container flex items-center gap-2 text-xs text-muted">
      <a href="/" class="hover:text-moss dark:hover:text-white">首页</a>
      <span>/</span>
      <span class="text-ink dark:text-white font-medium">Top 10 推荐榜</span>
    </div>
  </div>
  <div class="py-12 border-b border-line dark:border-white/10 bg-paper/60 dark:bg-black/20">
    <div class="container">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-moss/30 bg-moss/10 px-3 py-0.5 text-xs font-semibold text-moss dark:text-emerald-300 mb-4">
          <span>2026 年度评测榜单 · 综合评级</span>
        </div>
        <h1 class="font-heading text-3xl sm:text-5xl font-black text-ink dark:text-white tracking-tight">
          2026 Clash 机场排行榜
        </h1>
        <p class="mt-4 text-sm sm:text-base text-muted leading-relaxed">
          综合 42 家机场品牌的专线架构、晚高峰稳定性、门槛单价、支持协议及流媒体解锁能力，梳理出 2026 梯队推荐前十名与细分场景榜单。
        </p>
      </div>
    </div>
  </div>

  <div class="container py-12 space-y-16">
    <!-- Top 10 Section -->
    <section>
      <div class="mb-8">
        <span class="text-xs font-bold text-moss dark:text-coral-bright uppercase tracking-wider">Overall Top 10</span>
        <h2 class="font-heading text-2xl sm:text-3xl font-black text-ink dark:text-white mt-1">
          年度综合 Top 10 推荐总榜
        </h2>
        <p class="text-xs text-muted mt-1">
          第一主推光速云领衔，兼顾专线速度、客户端友好度与高性价比。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {top10.map((brand) => (
          <BrandCard brand={brand} />
        ))}
      </div>
    </section>

    <!-- Budget Sub-Ranking -->
    <section class="pt-8 border-t border-line dark:border-white/10">
      <div class="mb-8">
        <span class="text-xs font-bold text-moss dark:text-coral-bright uppercase tracking-wider">Budget Friendly</span>
        <h2 class="font-heading text-2xl sm:text-3xl font-black text-ink dark:text-white mt-1">
          月均 10 元以下 · 极低门槛性价比精选
        </h2>
        <p class="text-xs text-muted mt-1">
          适合学生党、轻度查资料与日常偶尔看油管的用户，成本低廉无压力。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {budgetBrands.map((brand) => (
          <BrandCard brand={brand} />
        ))}
      </div>
    </section>

    <!-- Premium IEPL/IPLC Sub-Ranking -->
    <section class="pt-8 border-t border-line dark:border-white/10">
      <div class="mb-8">
        <span class="text-xs font-bold text-moss dark:text-coral-bright uppercase tracking-wider">Enterprise Grade</span>
        <h2 class="font-heading text-2xl sm:text-3xl font-black text-ink dark:text-white mt-1">
          IEPL / IPLC 专线稳定榜 · 外贸办公与 AI 生产力
        </h2>
        <p class="text-xs text-muted mt-1">
          纯内网专线跨境，敏感时期不掉线，晚高峰 4K 秒开无丢包。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {ieplBrands.map((brand) => (
          <BrandCard brand={brand} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
