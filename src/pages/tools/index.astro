---
import BaseLayout from '@layouts/BaseLayout.astro';
import toolsContent from '../../data/tools-content.json';

const pageTitle = toolsContent.meta.title;
const pageDesc = toolsContent.meta.description;

function formatInlineMarkdown(text: string): string {
  if (!text) return '';
  return text
    .replace(/\*\*(.+?)\*\*/g, '<strong class="font-bold text-ink dark:text-white">$1</strong>')
    .replace(/`([^`]+)`/g, '<code class="rounded bg-moss/10 dark:bg-white/10 px-1.5 py-0.5 font-mono text-[11px] text-moss dark:text-emerald-300 break-all">$1</code>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="font-semibold text-moss dark:text-emerald-300 underline decoration-moss/40 underline-offset-4 hover:text-coral transition-colors">$1</a>');
}

const combinedSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: 'https://clashjichang.world/' },
        { '@type': 'ListItem', position: 2, name: '2026 梯子工程工具箱与节点诊断指南', item: 'https://clashjichang.world/tools' }
      ]
    },
    {
      '@type': 'TechArticle',
      headline: toolsContent.meta.h1,
      description: toolsContent.meta.description,
      datePublished: '2026-10-19',
      dateModified: toolsContent.meta.updatedAt,
      author: {
        '@type': 'Organization',
        name: toolsContent.meta.author,
        url: 'https://clashjichang.world/'
      },
      publisher: {
        '@type': 'Organization',
        name: 'Clash机场评测网',
        url: 'https://clashjichang.world/'
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': 'https://clashjichang.world/tools'
      }
    },
    {
      '@type': 'FAQPage',
      mainEntity: toolsContent.faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  schema={combinedSchema}
>
  <!-- Page Hero Header -->
  <header class="py-10 sm:py-14 border-b border-line dark:border-white/10 bg-paper/60 dark:bg-black/20">
    <div class="container max-w-6xl">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs text-muted flex flex-wrap items-center gap-1.5">
        <a href="/" class="hover:text-moss transition-colors">首页</a>
        <span>/</span>
        <span class="text-ink dark:text-white font-semibold">梯子工具箱与节点诊断专著</span>
      </nav>

      <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-moss/30 bg-moss/10 px-3.5 py-1 text-xs font-semibold text-moss dark:text-emerald-300 mb-4">
        <span>🛠️ 纯前端零上传诊断引擎</span>
        <span class="opacity-50">|</span>
        <span>倍率成本核算 · 带宽 BDP 换算 · 订阅安全与 IP 纯净度审计</span>
      </div>

      <h1 class="font-heading text-2xl sm:text-4xl lg:text-5xl font-black text-ink dark:text-white tracking-tight leading-tight">
        {toolsContent.meta.h1}
      </h1>

      <p class="mt-4 text-sm sm:text-base text-muted leading-relaxed max-w-4xl">
        {toolsContent.meta.description}
      </p>

      <!-- KPI Chips -->
      <div class="mt-7 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
        <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-3.5">
          <span class="text-muted block text-[11px]">内嵌交互工具</span>
          <span class="font-bold text-moss dark:text-emerald-400 font-mono">3 大纯本地计算器</span>
        </div>
        <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-3.5">
          <span class="text-muted block text-[11px]">IP 欺诈分安全线</span>
          <span class="font-bold text-ink dark:text-white font-mono">Scamalytics ≤ 25 分</span>
        </div>
        <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-3.5">
          <span class="text-muted block text-[11px]">推荐订阅管理器</span>
          <span class="font-bold text-ink dark:text-white font-mono">Sub-Store / 本地覆写</span>
        </div>
        <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-3.5">
          <span class="text-muted block text-[11px]">测速单位换算比</span>
          <span class="font-bold text-coral dark:text-coral-bright font-mono">1 MB/s = 8 Mbps</span>
        </div>
      </div>

      <!-- Metadata Bar -->
      <div class="mt-6 pt-5 border-t border-line/60 dark:border-white/10 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-muted">
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">研发团队：</span>
          <span>{toolsContent.meta.author}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">核验时间：</span>
          <span class="font-mono text-moss dark:text-emerald-300">{toolsContent.meta.verifiedAt}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">最后修订：</span>
          <time datetime={toolsContent.meta.updatedAt} class="font-mono">{toolsContent.meta.updatedAt}</time>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">阅读时长：</span>
          <span>{toolsContent.meta.readingTime}</span>
        </div>
      </div>
    </div>
  </header>

  <div class="container max-w-6xl py-8 sm:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Left Sticky TOC -->
      <aside class="lg:col-span-3 lg:sticky lg:top-20 rounded-2xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-4 sm:p-5 shadow-sm">
        <details class="group lg:open" open>
          <summary class="flex items-center justify-between cursor-pointer list-none font-heading text-sm font-black text-ink dark:text-white">
            <span class="flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-moss dark:bg-emerald-400"></span>
              工具箱章节目录 (TOC)
            </span>
            <span class="text-xs text-muted lg:hidden group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <nav aria-label="页内章节导航" class="mt-3 pt-3 border-t border-line/60 dark:border-white/10">
            <ul class="space-y-1.5 text-xs">
              {toolsContent.toc.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class="block py-1 px-2 rounded-lg text-muted hover:text-moss dark:hover:text-emerald-300 hover:bg-moss/5 dark:hover:bg-white/5 transition-colors leading-snug"
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-4 pt-3 border-t border-line/60 dark:border-white/10 space-y-1.5">
              <div class="text-[11px] font-bold text-ink dark:text-white">全站核心专题矩阵</div>
              <div class="flex flex-wrap gap-1.5 text-[11px]">
                <a href="/free" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">免费资源核验</a>
                <a href="/warnings" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">跑路预警雷达</a>
                <a href="/faq" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">机场百科FAQ</a>
                <a href="/clients" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">客户端大全</a>
                <a href="/speedtest" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">测速证据库</a>
              </div>
            </div>
          </nav>
        </details>
      </aside>

      <!-- Main Article Column -->
      <article class="lg:col-span-9 space-y-10 min-w-0">

        <!-- Module 0: Direct Answer Box -->
        <section id="direct-answer" class="scroll-mt-24 rounded-2xl border-2 border-moss/40 dark:border-emerald-500/40 bg-emerald-50/50 dark:bg-[#0d2625] p-5 sm:p-8 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 rounded-md bg-moss px-2.5 py-1 text-[11px] font-bold text-white uppercase tracking-wider">
              ⚡ 核心诊断准则前置 · 订阅防盗刷、IP 纯净度阈值与倍率真相
            </span>
            <span class="text-[11px] font-mono text-muted">Engineering Toolkit Executive Summary</span>
          </div>

          <p class="text-xs sm:text-sm text-ink dark:text-white font-medium leading-relaxed mb-5">
            {toolsContent.directAnswer.summary}
          </p>

          <div class="space-y-4">
            {toolsContent.directAnswer.points.map((pt) => (
              <div class="rounded-xl border border-moss/20 dark:border-white/10 bg-white/90 dark:bg-black/25 p-4 sm:p-5">
                <h2 class="font-heading text-sm sm:text-base font-black text-moss dark:text-emerald-300 mb-2">
                  {pt.label}
                </h2>
                <p class="text-xs sm:text-sm text-muted leading-relaxed" set:html={formatInlineMarkdown(pt.content)} />
              </div>
            ))}
          </div>

          <div class="mt-5 pt-4 border-t border-moss/20 dark:border-white/10">
            <div class="text-xs font-bold text-ink dark:text-white mb-2.5">按诊断目的快速直达工具与章节：</div>
            <div class="flex flex-wrap gap-2">
              {toolsContent.directAnswer.quickNav.map((nav) => (
                <a
                  href={nav.href}
                  class="inline-flex items-center gap-1 rounded-xl border border-moss/30 bg-white dark:bg-white/10 px-3 py-1.5 text-xs font-bold text-moss dark:text-emerald-300 hover:bg-moss hover:text-white transition-colors"
                >
                  <span>{nav.text}</span>
                </a>
              ))}
            </div>
          </div>
        </section>

        <!-- Interactive 3-in-1 Engineering Toolkit -->
        <section id="interactive-toolkit" class="scroll-mt-24 rounded-2xl border-2 border-moss/40 dark:border-emerald-500/40 bg-gradient-to-br from-emerald-50/70 via-white to-paper/60 dark:from-[#102a2b] dark:to-[#071312] p-5 sm:p-8 shadow-md space-y-6">
          <div>
            <span class="inline-flex items-center gap-1.5 rounded-md bg-moss px-2.5 py-1 text-[11px] font-bold text-white uppercase tracking-wider">
              🛠️ 三合一交互式工程工具箱 · 100% 本地浏览器运行 (零数据上传)
            </span>
            <h2 class="font-heading text-xl sm:text-2xl font-black text-ink dark:text-white mt-2">
              在线工具：流量倍率核算器 · 带宽与跨洋 BDP 换算器 · 订阅格式安全自检器
            </h2>
          </div>

          <!-- Tool 1: Multiplier & Real GB Cost Calculator -->
          <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-black/30 p-4 sm:p-5 space-y-4">
            <div class="flex items-center justify-between border-b border-line/60 dark:border-white/10 pb-2.5">
              <h3 class="font-heading text-sm sm:text-base font-black text-ink dark:text-white">
                工具 ①：套餐流量倍率（Multiplier）与真实可用 4K 视频时长核算器
              </h3>
              <span class="text-[11px] font-mono text-moss dark:text-emerald-300">识破虚假大流量陷阱</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
              <div>
                <label for="tool1-price" class="block font-bold text-ink dark:text-white mb-1">套餐月付价格 (元)：</label>
                <input id="tool1-price" type="number" value="25" min="1" max="500" class="w-full rounded-lg border border-line dark:border-white/20 bg-paper/50 dark:bg-white/5 px-3 py-2 font-mono text-sm text-ink dark:text-white" />
              </div>
              <div>
                <label for="tool1-gb" class="block font-bold text-ink dark:text-white mb-1">账面标称流量 (GB/月)：</label>
                <input id="tool1-gb" type="number" value="168" min="10" max="5000" class="w-full rounded-lg border border-line dark:border-white/20 bg-paper/50 dark:bg-white/5 px-3 py-2 font-mono text-sm text-ink dark:text-white" />
              </div>
              <div>
                <label for="tool1-mult" class="block font-bold text-ink dark:text-white mb-1">专线节点计费倍率 (×)：</label>
                <select id="tool1-mult" class="w-full rounded-lg border border-line dark:border-white/20 bg-paper/50 dark:bg-[#102a2b] px-3 py-2 font-mono text-sm text-ink dark:text-white">
                  <option value="1" selected>×1.0 倍 (如光速云/星岛梦/无忧链接实算)</option>
                  <option value="1.5">×1.5 倍 (轻度倍率节点)</option>
                  <option value="2">×2.0 倍 (常见双倍扣费节点)</option>
                  <option value="3">×3.0 倍 (高倍率原生解锁节点)</option>
                  <option value="5">×5.0 倍 (重度缩水套路节点)</option>
                </select>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs pt-1">
              <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/20 p-3">
                <span class="text-muted block text-[11px]">真实可用物理流量</span>
                <span id="tool1-real-gb" class="font-mono text-lg font-black text-emerald-700 dark:text-emerald-300">168.0 GB</span>
              </div>
              <div class="rounded-lg bg-paper dark:bg-white/5 border border-line/60 dark:border-white/10 p-3">
                <span class="text-muted block text-[11px]">每 1GB 真实物理流量单价</span>
                <span id="tool1-unit-cost" class="font-mono text-lg font-black text-ink dark:text-white">¥0.15 / GB</span>
              </div>
              <div class="rounded-lg bg-paper dark:bg-white/5 border border-line/60 dark:border-white/10 p-3">
                <span class="text-muted block text-[11px]">约合可看 YouTube 4K 时长</span>
                <span id="tool1-4k-hours" class="font-mono text-lg font-black text-moss dark:text-coral-bright">约 14.9 小时</span>
              </div>
            </div>
          </div>

          <!-- Tool 2: Speedtest Unit (MB/s <-> Mbps) & BDP Throughput Estimator -->
          <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-black/30 p-4 sm:p-5 space-y-4">
            <div class="flex items-center justify-between border-b border-line/60 dark:border-white/10 pb-2.5">
              <h3 class="font-heading text-sm sm:text-base font-black text-ink dark:text-white">
                工具 ②：MAI-TEST-BOT 测速单位换算（MB/s ↔ Mbps）与跨洋延迟 BDP 吞吐估算器
              </h3>
              <span class="text-[11px] font-mono text-moss dark:text-emerald-300">1 Byte = 8 bits</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
              <div>
                <label for="tool2-mbs" class="block font-bold text-ink dark:text-white mb-1">输入测速图显示的平均速度 (MB/s)：</label>
                <input id="tool2-mbs" type="number" value="66.1" step="0.5" min="0.5" max="500" class="w-full rounded-lg border border-line dark:border-white/20 bg-paper/50 dark:bg-white/5 px-3 py-2 font-mono text-sm text-ink dark:text-white" />
              </div>
              <div>
                <label for="tool2-rtt" class="block font-bold text-ink dark:text-white mb-1">输入节点往返延迟 RTT (ms)：</label>
                <input id="tool2-rtt" type="number" value="22" step="1" min="5" max="500" class="w-full rounded-lg border border-line dark:border-white/20 bg-paper/50 dark:bg-white/5 px-3 py-2 font-mono text-sm text-ink dark:text-white" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs pt-1">
              <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/20 p-3">
                <span class="text-muted block text-[11px]">等效运营商宽带兆数 (Mbps)</span>
                <span id="tool2-mbps" class="font-mono text-lg font-black text-emerald-700 dark:text-emerald-300">528.8 Mbps</span>
              </div>
              <div class="rounded-lg bg-paper dark:bg-white/5 border border-line/60 dark:border-white/10 p-3">
                <span class="text-muted block text-[11px]">满速所需最小 TCP 窗口 (BDP)</span>
                <span id="tool2-bdp" class="font-mono text-lg font-black text-ink dark:text-white">1.45 MB</span>
              </div>
              <div class="rounded-lg bg-paper dark:bg-white/5 border border-line/60 dark:border-white/10 p-3">
                <span class="text-muted block text-[11px]">流媒体并发承载评估</span>
                <span id="tool2-eval" class="font-mono text-xs font-bold text-moss dark:text-emerald-300 mt-1 block">可同时流畅播放 15+ 路 4K HDR 视频</span>
              </div>
            </div>
          </div>

          <!-- Tool 3: Local Subscription Format & Security Inspector -->
          <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-black/30 p-4 sm:p-5 space-y-4">
            <div class="flex items-center justify-between border-b border-line/60 dark:border-white/10 pb-2.5">
              <h3 class="font-heading text-sm sm:text-base font-black text-ink dark:text-white">
                工具 ③：订阅链接类型与 YAML 配置安全特征本地自检器（纯浏览器离线分析）
              </h3>
              <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400">🔒 零网络请求</span>
            </div>
            <div class="text-xs space-y-2">
              <label for="tool3-input" class="block font-bold text-ink dark:text-white">
                粘贴订阅链接格式样本、单节点 URI（如 `vless://`、`ss://`、`hysteria2://`）或 Clash YAML 片段：
              </label>
              <textarea
                id="tool3-input"
                rows="3"
                class="w-full rounded-lg border border-line dark:border-white/20 bg-paper/50 dark:bg-white/5 p-3 font-mono text-xs text-ink dark:text-white"
                placeholder="示例：vless://uuid@example.com:443?security=reality&sni=www.apple.com#HK-IEPL 或粘贴 YAML 片段（如 external-controller: 127.0.0.1:9090）"
              >vless://demo-uuid@hk-bgp.example.com:443?encryption=none&security=tls&type=ws#香港IEPL专线-01</textarea>
              <div id="tool3-output" class="rounded-lg border border-moss/30 bg-emerald-50/60 dark:bg-black/40 p-3 text-xs font-mono text-ink dark:text-white leading-relaxed">
                正在初始化本地自检器...
              </div>
            </div>
          </div>

          <script is:inline>
            (function () {
              // Tool 1 logic
              const p1 = document.getElementById('tool1-price');
              const g1 = document.getElementById('tool1-gb');
              const m1 = document.getElementById('tool1-mult');
              const outRealGb = document.getElementById('tool1-real-gb');
              const outUnit = document.getElementById('tool1-unit-cost');
              const out4k = document.getElementById('tool1-4k-hours');

              function updateTool1() {
                if (!p1 || !g1 || !m1) return;
                const price = parseFloat(p1.value) || 25;
                const gb = parseFloat(g1.value) || 168;
                const mult = parseFloat(m1.value) || 1;
                const realGb = gb / mult;
                const unitCost = price / realGb;
                const hours4k = realGb / 11.25; // ~25Mbps = 11.25GB/hour
                outRealGb.textContent = realGb.toFixed(1) + ' GB (按 ×' + mult + ' 折算)';
                outUnit.textContent = '¥' + unitCost.toFixed(2) + ' / 真实GB';
                out4k.textContent = '约 ' + hours4k.toFixed(1) + ' 小时 (25Mbps码率)';
              }
              [p1, g1, m1].forEach((el) => el && el.addEventListener('input', updateTool1));
              updateTool1();

              // Tool 2 logic
              const mbsInput = document.getElementById('tool2-mbs');
              const rttInput = document.getElementById('tool2-rtt');
              const outMbps = document.getElementById('tool2-mbps');
              const outBdp = document.getElementById('tool2-bdp');
              const outEval = document.getElementById('tool2-eval');

              function updateTool2() {
                if (!mbsInput || !rttInput) return;
                const mbs = parseFloat(mbsInput.value) || 66.1;
                const rtt = parseFloat(rttInput.value) || 22;
                const mbps = mbs * 8;
                const bdpMB = mbs * (rtt / 1000);
                outMbps.textContent = mbps.toFixed(1) + ' Mbps';
                outBdp.textContent = bdpMB.toFixed(2) + ' MB 缓冲窗口';
                const streams = Math.floor(mbps / 30);
                if (streams >= 10) {
                  outEval.textContent = '🔥 顶级专线水准：可同时承载 ' + streams + ' 路 4K 视频流';
                } else if (streams >= 2) {
                  outEval.textContent = '✅ 流畅水准：可同时承载 ' + streams + ' 路 4K 视频与 AI 对话';
                } else {
                  outEval.textContent = '⚠️ 适合网页/AI文本与 1080P 视频（受跨洋延迟或带宽限制）';
                }
              }
              [mbsInput, rttInput].forEach((el) => el && el.addEventListener('input', updateTool2));
              updateTool2();

              // Tool 3 logic
              const t3Input = document.getElementById('tool3-input');
              const t3Output = document.getElementById('tool3-output');

              function updateTool3() {
                if (!t3Input || !t3Output) return;
                const val = (t3Input.value || '').trim();
                if (!val) {
                  t3Output.textContent = '请在上方输入框粘贴协议链接或 YAML 配置片段进行本地诊断。';
                  return;
                }
                const findings = [];
                if (/^vless:\/\//i.test(val)) {
                  findings.push('✅ 识别为 [VLESS] 单节点 URI（主流抗封锁轻量协议，需 Clash Meta/Mihomo、v2rayN 或小火箭支持）。');
                  if (/security=reality/i.test(val)) findings.push('🛡️ 检测到 [Reality] 偷取指纹增强特性，抗主动探测能力极强。');
                } else if (/^(hysteria2|hy2):\/\//i.test(val)) {
                  findings.push('🚀 识别为 [Hysteria 2] 基于 QUIC/UDP 的暴力发包加速协议，高丢包晚高峰克星。');
                } else if (/^ss:\/\//i.test(val)) {
                  findings.push('✅ 识别为 [Shadowsocks] 经典流加密协议（IEPL/IPLC 内网专线机场最常用的低开销承载协议）。');
                } else if (/^trojan:\/\//i.test(val)) {
                  findings.push('✅ 识别为 [Trojan] 伪装 HTTPS 流量协议。');
                } else if (/^vmess:\/\//i.test(val)) {
                  findings.push('ℹ️ 识别为 [VMess] 传统协议（建议优先升级至 VLESS 或 Shadowsocks 2022）。');
                } else if (/^https?:\/\//i.test(val)) {
                  findings.push('🔗 识别为 [HTTPS 远程订阅链接]。');
                  if (/sub\?|target=clash|url=http/i.test(val)) {
                    findings.push('🚨 [高危预警] 该链接疑似经过第三方在线 subconverter 转换！请确认转换后端为您本人自建，切勿使用陌生公共转换站以免泄露 Token！');
                  } else {
                    findings.push('✅ 属于机场原生直出订阅 URL，请直接粘贴进 Clash Verge Rev / 小火箭，切勿发给他人。');
                  }
                }
                if (/external-controller:\s*0\.0\.0\.0/i.test(val)) {
                  findings.push('🔴 [严重安全漏洞] 检测到 external-controller 绑定在 0.0.0.0！请立即改为 127.0.0.1:9090 防止局域网劫持！');
                } else if (/external-controller:\s*127\.0\.0\.1/i.test(val)) {
                  findings.push('🟢 检测到本地控制端口安全绑定在 127.0.0.1 回环地址。');
                }
                if (findings.length === 0) {
                  findings.push('ℹ️ 已完成本地扫描：未发现 0.0.0.0 端口暴露或第三方在线转换嵌套特征。');
                }
                t3Output.innerHTML = findings.join('<br/>');
              }
              if (t3Input) t3Input.addEventListener('input', updateTool3);
              updateTool3();
            })();
          </script>
