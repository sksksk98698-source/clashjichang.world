---
import BaseLayout from '@layouts/BaseLayout.astro';
import brandsData from '../../data/brands.json';
import warningsContent from '../../data/warnings-content.json';

const pageTitle = warningsContent.meta.title;
const pageDesc = warningsContent.meta.description;

function formatInlineMarkdown(text: string): string {
  if (!text) return '';
  return text
    .replace(/\*\*(.+?)\*\*/g, '<strong class="font-bold text-ink dark:text-white">$1</strong>')
    .replace(/`([^`]+)`/g, '<code class="rounded bg-moss/10 dark:bg-white/10 px-1.5 py-0.5 font-mono text-[11px] text-moss dark:text-emerald-300 break-all">$1</code>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="font-semibold text-moss dark:text-emerald-300 underline decoration-moss/40 underline-offset-4 hover:text-coral transition-colors">$1</a>');
}

const combinedSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: 'https://clashjichang.world/' },
        { '@type': 'ListItem', position: 2, name: '2026 机场跑路预警与风险避坑雷达', item: 'https://clashjichang.world/warnings' }
      ]
    },
    {
      '@type': 'TechArticle',
      headline: warningsContent.meta.h1,
      description: warningsContent.meta.description,
      datePublished: '2026-10-19',
      dateModified: warningsContent.meta.updatedAt,
      author: {
        '@type': 'Organization',
        name: warningsContent.meta.author,
        url: 'https://clashjichang.world/'
      },
      publisher: {
        '@type': 'Organization',
        name: 'Clash机场评测网',
        url: 'https://clashjichang.world/'
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': 'https://clashjichang.world/warnings'
      }
    },
    {
      '@type': 'FAQPage',
      mainEntity: warningsContent.faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  schema={combinedSchema}
>
  <!-- Page Hero Header -->
  <header class="py-10 sm:py-14 border-b border-line dark:border-white/10 bg-paper/60 dark:bg-black/20">
    <div class="container max-w-6xl">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs text-muted flex flex-wrap items-center gap-1.5">
        <a href="/" class="hover:text-moss transition-colors">首页</a>
        <span>/</span>
        <span class="text-ink dark:text-white font-semibold">机场跑路预警与避坑雷达</span>
      </nav>

      <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-coral/30 bg-coral/10 px-3.5 py-1 text-xs font-semibold text-coral dark:text-coral-bright mb-4">
        <span>🚨 42家全库背景调查与风险审计</span>
        <span class="opacity-50">|</span>
        <span>深扒同源马甲 · 识别 5.6 元同构盘 · 10 大跑路红旗自测</span>
      </div>

      <h1 class="font-heading text-2xl sm:text-4xl lg:text-5xl font-black text-ink dark:text-white tracking-tight leading-tight">
        {warningsContent.meta.h1}
      </h1>

      <p class="mt-4 text-sm sm:text-base text-muted leading-relaxed max-w-4xl">
        {warningsContent.meta.description}
      </p>

      <!-- KPI Chips -->
      <div class="mt-7 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
        <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-3.5">
          <span class="text-muted block text-[11px]">5–6 年零跑路老牌</span>
          <span class="font-bold text-moss dark:text-emerald-400 font-mono">光速云 / 星岛梦 / 青云梯</span>
        </div>
        <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-3.5">
          <span class="text-muted block text-[11px]">核心同源矩阵披露</span>
          <span class="font-bold text-ink dark:text-white font-mono">微风/飞鸟/一云梯/龙猫云</span>
        </div>
        <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-3.5">
          <span class="text-muted block text-[11px]">克隆同构低价预警</span>
          <span class="font-bold text-amber-700 dark:text-amber-400 font-mono">第38–42名 (¥5.6/月盘)</span>
        </div>
        <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-3.5">
          <span class="text-muted block text-[11px]">最佳防失联容灾公式</span>
          <span class="font-bold text-coral dark:text-coral-bright font-mono">主力年付 + 异构永久包</span>
        </div>
      </div>

      <!-- Metadata Bar -->
      <div class="mt-6 pt-5 border-t border-line/60 dark:border-white/10 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-muted">
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">风控团队：</span>
          <span>{warningsContent.meta.author}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">核验时间：</span>
          <span class="font-mono text-moss dark:text-emerald-300">{warningsContent.meta.verifiedAt}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">最后修订：</span>
          <time datetime={warningsContent.meta.updatedAt} class="font-mono">{warningsContent.meta.updatedAt}</time>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">阅读时长：</span>
          <span>{warningsContent.meta.readingTime}</span>
        </div>
      </div>
    </div>
  </header>

  <div class="container max-w-6xl py-8 sm:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Left Sticky TOC -->
      <aside class="lg:col-span-3 lg:sticky lg:top-20 rounded-2xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-4 sm:p-5 shadow-sm">
        <details class="group lg:open" open>
          <summary class="flex items-center justify-between cursor-pointer list-none font-heading text-sm font-black text-ink dark:text-white">
            <span class="flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-coral"></span>
              跑路预警章节目录 (TOC)
            </span>
            <span class="text-xs text-muted lg:hidden group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <nav aria-label="页内章节导航" class="mt-3 pt-3 border-t border-line/60 dark:border-white/10">
            <ul class="space-y-1.5 text-xs">
              {warningsContent.toc.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class="block py-1 px-2 rounded-lg text-muted hover:text-moss dark:hover:text-emerald-300 hover:bg-moss/5 dark:hover:bg-white/5 transition-colors leading-snug"
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-4 pt-3 border-t border-line/60 dark:border-white/10 space-y-1.5">
              <div class="text-[11px] font-bold text-ink dark:text-white">全站核心专题矩阵</div>
              <div class="flex flex-wrap gap-1.5 text-[11px]">
                <a href="/free" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">免费资源核验</a>
                <a href="/tools" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">梯子工具箱</a>
                <a href="/faq" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">机场百科FAQ</a>
                <a href="/brands" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">42家品牌库</a>
                <a href="/speedtest" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">17份测速原图</a>
              </div>
            </div>
          </nav>
        </details>
      </aside>

      <!-- Main Article Column -->
      <article class="lg:col-span-9 space-y-10 min-w-0">

        <!-- Module 0: Direct Answer Box -->
        <section id="direct-answer" class="scroll-mt-24 rounded-2xl border-2 border-moss/40 dark:border-emerald-500/40 bg-emerald-50/50 dark:bg-[#0d2625] p-5 sm:p-8 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 rounded-md bg-moss px-2.5 py-1 text-[11px] font-bold text-white uppercase tracking-wider">
              ⚡ 核心风控结论前置 · 42家同源站群底牌、5.6元同构盘警示与跑路红旗
            </span>
            <span class="text-[11px] font-mono text-muted">Risk Audit Executive Summary</span>
          </div>

          <p class="text-xs sm:text-sm text-ink dark:text-white font-medium leading-relaxed mb-5">
            {warningsContent.directAnswer.summary}
          </p>

          <div class="space-y-4">
            {warningsContent.directAnswer.points.map((pt) => (
              <div class="rounded-xl border border-moss/20 dark:border-white/10 bg-white/90 dark:bg-black/25 p-4 sm:p-5">
                <h2 class="font-heading text-sm sm:text-base font-black text-moss dark:text-emerald-300 mb-2">
                  {pt.label}
                </h2>
                <p class="text-xs sm:text-sm text-muted leading-relaxed">
                  {pt.content}
                </p>
              </div>
            ))}
          </div>

          <div class="mt-5 pt-4 border-t border-moss/20 dark:border-white/10">
            <div class="text-xs font-bold text-ink dark:text-white mb-2.5">按核查需求快速直达风控模块：</div>
            <div class="flex flex-wrap gap-2">
              {warningsContent.directAnswer.quickNav.map((nav) => (
                <a
                  href={nav.href}
                  class="inline-flex items-center gap-1 rounded-xl border border-moss/30 bg-white dark:bg-white/10 px-3 py-1.5 text-xs font-bold text-moss dark:text-emerald-300 hover:bg-moss hover:text-white transition-colors"
                >
                  <span>{nav.text}</span>
                </a>
              ))}
            </div>
          </div>
        </section>

        <!-- Interactive Risk Radar & 10 Red-Flag Self-Tester -->
        <section id="interactive-risk-radar" class="scroll-mt-24 rounded-2xl border-2 border-moss/40 dark:border-emerald-500/40 bg-gradient-to-br from-emerald-50/70 via-white to-paper/60 dark:from-[#102a2b] dark:to-[#071312] p-5 sm:p-8 shadow-md space-y-6">
          <div>
            <span class="inline-flex items-center gap-1.5 rounded-md bg-moss px-2.5 py-1 text-[11px] font-bold text-white uppercase tracking-wider">
              🔍 双核交互式风控雷达 · 42家机场同源/风险查询器 & 跑路前兆 10 项红旗自测表
            </span>
            <h2 class="font-heading text-xl sm:text-2xl font-black text-ink dark:text-white mt-2">
              在线核查：输入或选择任意一家机场，秒查其同源派系、实测图状态与最佳买法
            </h2>
          </div>

          <!-- Widget A: 42-Brand Risk & Lineage Instant Lookup -->
          <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-black/30 p-4 sm:p-5 space-y-4">
            <label for="radar-brand-select" class="block text-xs font-bold text-ink dark:text-white">
              工具 ①：选择站内收录的 42 家机场品牌进行背景与风险穿透核查：
            </label>
            <select
              id="radar-brand-select"
              class="w-full rounded-xl border border-line dark:border-white/20 bg-paper/60 dark:bg-[#102a2b] px-3.5 py-2.5 text-xs sm:text-sm font-bold text-ink dark:text-white"
            >
              {brandsData.map((b) => (
                <option value={b.slug} data-rank={b.rank} data-name={b.name} data-price={b.priceStr} data-line={b.lineType} data-proto={b.protocol} data-img={b.speedtestImg ? 'yes' : 'no'}>
                  TOP {b.rank} · {b.name} ({b.priceStr})
                </option>
              ))}
            </select>

            <div id="radar-brand-result" class="rounded-xl border border-moss/30 bg-emerald-50/50 dark:bg-black/40 p-4 text-xs space-y-2 leading-relaxed">
              正在加载品牌风控档案...
            </div>
          </div>

          <!-- Widget B: 10 Red-Flag Exit-Scam Self-Tester -->
          <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-black/30 p-4 sm:p-5 space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line/60 dark:border-white/10 pb-2.5">
              <h3 class="font-heading text-sm sm:text-base font-black text-ink dark:text-white">
                工具 ②：外部机场「跑路前兆 10 大红旗」交互自测器（勾选您遇到的症状）
              </h3>
              <span id="redflag-score-badge" class="rounded-full bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 px-3 py-0.5 font-mono text-xs font-bold">
                当前命中：0 / 10 项 (安全)
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs">
              <label class="flex items-start gap-2 p-2.5 rounded-lg border border-line/60 dark:border-white/10 hover:bg-paper/40 cursor-pointer">
                <input type="checkbox" class="rf-check mt-0.5 accent-coral" value="25" />
                <span>1. 非大促日突发“1折–3折三年付/终身无限流量”清仓甩卖</span>
              </label>
              <label class="flex items-start gap-2 p-2.5 rounded-lg border border-line/60 dark:border-white/10 hover:bg-paper/40 cursor-pointer">
                <input type="checkbox" class="rf-check mt-0.5 accent-coral" value="25" />
                <span>2. 官方 Telegram 群突然开启长期「全员禁言」且踢出提问老客</span>
              </label>
              <label class="flex items-start gap-2 p-2.5 rounded-lg border border-line/60 dark:border-white/10 hover:bg-paper/40 cursor-pointer">
                <input type="checkbox" class="rf-check mt-0.5 accent-coral" value="20" />
                <span>3. 原本 25ms 的香港 IEPL 专线大面积离线，退化为 180ms+ 直连</span>
              </label>
              <label class="flex items-start gap-2 p-2.5 rounded-lg border border-line/60 dark:border-white/10 hover:bg-paper/40 cursor-pointer">
                <input type="checkbox" class="rf-check mt-0.5 accent-coral" value="15" />
                <span>4. 突然下架月付/季付选项，强制所有老用户只能续费年付</span>
              </label>
              <label class="flex items-start gap-2 p-2.5 rounded-lg border border-line/60 dark:border-white/10 hover:bg-paper/40 cursor-pointer">
                <input type="checkbox" class="rf-check mt-0.5 accent-coral" value="15" />
                <span>5. 后台工单超过 72 小时至一周完全无人响应</span>
              </label>
              <label class="flex items-start gap-2 p-2.5 rounded-lg border border-line/60 dark:border-white/10 hover:bg-paper/40 cursor-pointer">
                <input type="checkbox" class="rf-check mt-0.5 accent-coral" value="15" />
                <span>6. 支付宝/微信接口掉线，长期只接受无法追索的 USDT 充值</span>
              </label>
              <label class="flex items-start gap-2 p-2.5 rounded-lg border border-line/60 dark:border-white/10 hover:bg-paper/40 cursor-pointer">
                <input type="checkbox" class="rf-check mt-0.5 accent-coral" value="20" />
                <span>7. 要求已买年付的老用户额外补交“VIP专线通道激活费”</span>
              </label>
              <label class="flex items-start gap-2 p-2.5 rounded-lg border border-line/60 dark:border-white/10 hover:bg-paper/40 cursor-pointer">
                <input type="checkbox" class="rf-check mt-0.5 accent-coral" value="10" />
                <span>8. 套餐定价极度违背物理常识（如 ¥5.6/月同构盘要买年付）</span>
              </label>
              <label class="flex items-start gap-2 p-2.5 rounded-lg border border-line/60 dark:border-white/10 hover:bg-paper/40 cursor-pointer">
                <input type="checkbox" class="rf-check mt-0.5 accent-coral" value="10" />
                <span>9. 订阅域名被墙后超半个月不更换，且无备用防失联发布页</span>
              </label>
              <label class="flex items-start gap-2 p-2.5 rounded-lg border border-line/60 dark:border-white/10 hover:bg-paper/40 cursor-pointer">
                <input type="checkbox" class="rf-check mt-0.5 accent-coral" value="10" />
                <span>10. 原生解锁 IP 全部失效，退化为欺诈分 100 的万人骑机房 IP</span>
              </label>
            </div>

            <div id="redflag-verdict" class="rounded-xl border border-line dark:border-white/10 bg-paper/60 dark:bg-white/5 p-3.5 text-xs font-medium text-ink dark:text-white">
              请勾选上方您在某家机场观察到的现象，系统将自动评估跑路风险等级。
            </div>
          </div>

          <script is:inline>
            (function () {
              const selectEl = document.getElementById('radar-brand-select');
              const resultEl = document.getElementById('radar-brand-result');

              const flyingBirdGroup = ['weifeng', 'firefly', 'flyingbird', 'longmaoyun', 'yinghuochong'];
              const clone56Group = ['dalaoyun', 'shandianshu', 'yunjiexian', 'liulianyun', 'huanqiuti'];
              const veteranGroup = ['guangsu-cloud', 'xingdaomeng', 'qingyunti', 'yinxingren', 'fatcat'];
              const histGroup = ['wgetcloud', 'baiyueguang', 'shanshuiyun', 'cyberguard', 'lingdongyun'];
              const new2025Group = ['u1s1', 'jilian-cloud', 'guangnianti', 'yifanyun', 'sogo-cloud', 'quanqiuyun', 'tiziyun'];

              function updateBrandRadar() {
                if (!selectEl || !resultEl) return;
                const opt = selectEl.options[selectEl.selectedIndex];
                const slug = selectEl.value;
                const name = opt.getAttribute('data-name');
                const rank = opt.getAttribute('data-rank');
                const hasImg = opt.getAttribute('data-img') === 'yes';

                let riskBadge = '🟢 实测验证 · 稳健推荐';
                let lineageNote = '独立运营品牌（非 5.6 元同构盘）。';
                let buyAdvice = '具备完整参数核验，支持按需选择月付、年付或永久不限时套餐。';

                if (veteranGroup.includes(slug)) {
                  riskBadge = '🛡️ 五星安全 · 2020–2021 骨灰级老牌避风港';
                  lineageNote = slug === 'qingyunti'
                    ? '由 2021 年初知名老牌「V4Speed」正式品牌升级而来，至今稳定运营超 5 年。'
                    : '创设于 2020 年前后，历经 5–6 年跨周期洗牌依然稳健存续的顶级老牌。';
                  buyAdvice = '抗风险能力位列全站最高梯队，可放心入手百元内年付（如光速云 ¥99/年、星岛梦/青云梯 ¥96/年）或永久不限时包（光速云 ¥147/247GB）。';
                } else if (flyingBirdGroup.includes(slug)) {
                  riskBadge = '🟢 一线专线 · 飞鸟/一云梯同源技术矩阵';
                  lineageNote = '与【微风网络 / Firefly / FlyingBird(飞鸟) / 一云梯 / 龙猫云】属同源专线生态矩阵，共享高规格 IEPL/IPLC 与原生 IP 资源。';
                  buyAdvice = '单买一家非常稳健高速；但若配置“双机场备份”，第二家备用请务必跨生态选择【光速云】或【二猫云】，切勿在同源矩阵内重复购买！';
                } else if (slug === 'tntcloud') {
                  riskBadge = '🟢 3年老牌 · 原 3A 加速器更名升级';
                  lineageNote = '由原「3A 加速器」正式更名升级为 TNTCloud，全线 IPLC 专线不限设备数。';
                  buyAdvice = '认准 TNTCloud 现用名，主打季付 ¥60 起周期套餐，配合 85 折优惠码性价比良好。';
                } else if (clone56Group.includes(slug)) {
                  riskBadge = '🟠 重点预警 · 5.6元克隆级同构低价盘';
                  lineageNote = '与【大佬云 / 闪电鼠 / 云界线 / 榴莲云 / 环球梯】套餐定价（¥5.6/30G、¥54/年）100% 同构，且缺乏 2026-08-11 原始测速图' + (slug === 'yunjiexian' || slug === 'huanqiuti' ? '，推广链接还存在缺少 # 号异常。' : slug === 'liulianyun' ? '，且底层协议待核实。' : '。');
                  buyAdvice = '⚠️ 严禁购买 ¥54 年付或 ¥132 两年付！最多仅限掏 ¥5.6 元买 1 个月短期尝鲜；若需年付请加 20 元选无忧链接(¥79/年)或光速云(¥99/年)。';
                } else if (slug === 'yuzhou-cloud') {
                  riskBadge = '🟡 资料缺口提示 · 含珍贵晚高峰实测图';
                  lineageNote = '拥有 2026-08-11 21:04 晚高峰 VLESS 实测原图，但缺失现行完整套餐流量梯度与退款细则。';
