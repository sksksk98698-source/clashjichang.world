---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content } = await render(post);
const relatedPosts = posts.filter((candidate) => candidate.id !== post.id).slice(0, 2);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://clashjichang.world' },
    { '@type': 'ListItem', position: 2, name: '博客与评测', item: 'https://clashjichang.world/blog' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: `https://clashjichang.world/blog/${post.id}` }
  ]
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  url: `https://clashjichang.world/blog/${post.id}`,
  mainEntityOfPage: `https://clashjichang.world/blog/${post.id}`,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: post.data.publishedAt.toISOString(),
  author: {
    '@type': 'Organization',
    name: 'Clash机场评测实验室',
    url: 'https://clashjichang.world'
  },
  publisher: {
    '@type': 'Organization',
    name: 'Clash机场',
    url: 'https://clashjichang.world'
  }
};
---

<BaseLayout
  title={`${post.data.title} | Clash机场评测`}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.publishedAt.toISOString()}
  modifiedTime={post.data.publishedAt.toISOString()}
  author="Clash机场评测实验室"
  category={post.data.category}
  tags={post.data.tags}
  schema={[breadcrumbSchema, articleSchema]}
>
  <article class="container max-w-4xl py-12 sm:py-20">
    <header class="border-b border-line dark:border-white/10 pb-8">
      <div class="flex items-center gap-2 text-xs mb-3">
        <a href="/blog" class="text-moss dark:text-emerald-400 font-bold hover:underline">
          博客与评测
        </a>
        <span class="text-muted">/</span>
        <span class="text-muted">{post.data.category}</span>
      </div>

      <h1 class="font-heading text-3xl sm:text-5xl font-black text-ink dark:text-white leading-[1.3] tracking-tight">
        {post.data.title}
      </h1>

      <p class="mt-4 text-base sm:text-lg text-muted leading-relaxed">
        {post.data.description}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4 text-xs text-muted">
        <time datetime={post.data.publishedAt.toISOString()} class="font-mono">
          发布日期：{post.data.publishedAt.toISOString().split('T')[0]}
        </time>
        <span>·</span>
        <span class="font-mono">{post.data.readingTime}</span>
      </div>

      {post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="rounded-full border border-line dark:border-white/10 bg-paper dark:bg-white/5 px-2.5 py-0.5 text-xs font-mono text-moss dark:text-emerald-300">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="mt-10 grid min-w-0 gap-10 lg:grid-cols-[.26fr_.74fr]">
      <!-- Table of contents -->
      <aside class="hidden lg:block lg:sticky lg:top-24 lg:h-fit">
        <p class="text-xs font-bold text-moss dark:text-coral-bright uppercase tracking-wider mb-2">文章目录</p>
        <nav id="toc-container" data-server-toc data-max-depth="3" class="text-xs text-muted space-y-1.5" aria-label="文章目录"></nav>
      </aside>

      <!-- Main markdown content -->
      <div class="min-w-0">
        <div
          id="article-content"
          class="prose prose-base sm:prose-lg max-w-none dark:prose-invert leading-relaxed text-ink dark:text-gray-200
          [&_a]:font-bold [&_a]:text-moss dark:[&_a]:text-emerald-400 [&_a]:underline [&_a]:underline-offset-4
          [&_h2]:mt-10 [&_h2]:scroll-mt-24 [&_h2]:font-heading [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-ink dark:[&_h2]:text-white
          [&_h3]:mt-6 [&_h3]:font-heading [&_h3]:text-lg [&_h3]:font-bold
          [&_p]:mt-4 [&_p]:text-muted dark:[&_p]:text-gray-300 [&_p]:leading-relaxed
          [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1.5 [&_ul]:text-muted dark:[&_ul]:text-gray-300
          [&_table]:mt-6 [&_table]:w-full [&_table]:text-xs
          [&_th]:border-b [&_th]:border-line dark:[&_th]:border-white/10 [&_th]:p-2.5 [&_th]:font-bold
          [&_td]:border-b [&_td]:border-line/60 dark:[&_td]:border-white/5 [&_td]:p-2.5
          [&_code]:rounded [&_code]:bg-paper dark:[&_code]:bg-white/10 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-xs"
        >
          <Content />
        </div>

        <!-- Core Hub Navigation -->
        <div class="mt-12 pt-6 border-t border-line dark:border-white/10">
          <span class="text-xs font-bold text-ink dark:text-white block mb-3">延伸专著级专题核查：</span>
          <div class="flex flex-wrap gap-2 text-xs">
            <a href="/ranking" class="rounded-lg border border-line dark:border-white/10 bg-paper dark:bg-white/5 px-3 py-1.5 font-semibold text-moss dark:text-emerald-300 hover:underline">🏆 Top 10 机场推荐榜</a>
            <a href="/speedtest" class="rounded-lg border border-line dark:border-white/10 bg-paper dark:bg-white/5 px-3 py-1.5 font-semibold text-moss dark:text-emerald-300 hover:underline">📊 17份测速原图库</a>
            <a href="/guide" class="rounded-lg border border-line dark:border-white/10 bg-paper dark:bg-white/5 px-3 py-1.5 font-semibold text-moss dark:text-emerald-300 hover:underline">🌐 IEPL专线与协议科普</a>
            <a href="/clients" class="rounded-lg border border-line dark:border-white/10 bg-paper dark:bg-white/5 px-3 py-1.5 font-semibold text-moss dark:text-emerald-300 hover:underline">💻 全平台客户端下载</a>
            <a href="/warnings" class="rounded-lg border border-line dark:border-white/10 bg-paper dark:bg-white/5 px-3 py-1.5 font-semibold text-moss dark:text-emerald-300 hover:underline">🚨 跑路预警与同源核查</a>
            <a href="/tools" class="rounded-lg border border-line dark:border-white/10 bg-paper dark:bg-white/5 px-3 py-1.5 font-semibold text-moss dark:text-emerald-300 hover:underline">🛠️ 倍率与IP诊断工具箱</a>
          </div>
        </div>

        <!-- Related posts -->
        {relatedPosts.length > 0 && (
          <section class="mt-12 pt-8 border-t border-line dark:border-white/10">
            <h3 class="font-heading text-lg font-bold text-ink dark:text-white mb-4">
              推荐相关阅读
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedPosts.map((related) => (
                <a
                  href={`/blog/${related.id}`}
                  class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-4 hover:shadow-md transition-all block"
                >
                  <span class="text-[11px] font-bold text-moss dark:text-coral-bright">{related.data.category}</span>
                  <h4 class="font-bold text-sm text-ink dark:text-white mt-1 line-clamp-1">{related.data.title}</h4>
                  <p class="text-xs text-muted mt-1 line-clamp-2">{related.data.description}</p>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>

    <footer class="mt-12 border-t border-line dark:border-white/10 pt-6">
      <a href="/blog" class="text-xs font-bold text-moss dark:text-emerald-400 hover:underline">
        ← 返回博客与评测列表
      </a>
    </footer>
  </article>
</BaseLayout>
