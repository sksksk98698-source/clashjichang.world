---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (first, second) => second.data.publishedAt.valueOf() - first.data.publishedAt.valueOf(),
);
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const otherPosts = posts.filter((post) => post.id !== featuredPost?.id);

const pageTitle = 'Clash 机场评测博客与使用教程 | 节点专线与客户端知识库 - clashjichang.world';
const pageDesc = '精选 Clash 机场评测深度长文、IPLC/IEPL 专线知识科普、42 家品牌实测报告及全平台客户端上手配置教程。';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://clashjichang.world' },
    { '@type': 'ListItem', position: 2, name: '评测与博客', item: 'https://clashjichang.world/blog' }
  ]
};

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  url: 'https://clashjichang.world/blog',
  description: pageDesc
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  schema={[breadcrumbSchema, collectionPageSchema]}
>
  <div class="border-b border-line dark:border-white/10 bg-paper/50 dark:bg-black/20 py-3">
    <div class="container flex items-center gap-2 text-xs text-muted">
      <a href="/" class="hover:text-moss dark:hover:text-white">首页</a>
      <span>/</span>
      <span class="text-ink dark:text-white font-medium">评测与教程博客</span>
    </div>
  </div>
  <div class="py-12 border-b border-line dark:border-white/10 bg-paper/60 dark:bg-black/20">
    <div class="container">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-moss/30 bg-moss/10 px-3 py-0.5 text-xs font-semibold text-moss dark:text-emerald-300 mb-4">
          <span>专业深度科普 · 实测经验分享</span>
        </div>
        <h1 class="font-heading text-3xl sm:text-5xl font-black text-ink dark:text-white tracking-tight">
          机场评测与客户端教程博客
        </h1>
        <p class="mt-4 text-sm sm:text-base text-muted leading-relaxed">
          深入浅出解析专线原理、测速报告分析、协议选型与常见连接故障排查，助您掌握科学上网核心技能。
        </p>
      </div>
    </div>
  </div>

  <div class="container py-12 space-y-12">
    <!-- Featured Article -->
    {featuredPost && (
      <section class="rounded-3xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-6 sm:p-10 shadow-sm hover:shadow-md transition-all">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8">
            <div class="flex items-center gap-2 mb-3">
              <span class="rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 font-bold text-xs px-2.5 py-0.5 border border-emerald-500/20">
                本期精选 · {featuredPost.data.category}
              </span>
              <span class="text-xs text-muted font-mono">{featuredPost.data.readingTime}</span>
            </div>
            <h2 class="font-heading text-2xl sm:text-3xl font-black text-ink dark:text-white tracking-tight">
              <a href={`/blog/${featuredPost.id}`} class="hover:text-moss dark:hover:text-coral-bright transition-colors">
                {featuredPost.data.title}
              </a>
            </h2>
            <p class="mt-4 text-sm text-muted leading-relaxed">
              {featuredPost.data.description}
            </p>
            <div class="mt-6 flex items-center gap-4">
              <a
                href={`/blog/${featuredPost.id}`}
                class="rounded-xl bg-moss hover:bg-moss-dark text-white font-bold text-xs sm:text-sm px-5 py-2.5 transition-all"
              >
                阅读全文 →
              </a>
              <time class="text-xs text-muted font-mono" datetime={featuredPost.data.publishedAt.toISOString()}>
                {featuredPost.data.publishedAt.toISOString().split('T')[0]}
              </time>
            </div>
          </div>
          <div class="lg:col-span-4 rounded-2xl bg-paper dark:bg-white/5 border border-line dark:border-white/10 p-6 flex flex-col justify-center items-center text-center">
            <span class="text-4xl block mb-2">📖</span>
            <span class="font-heading font-bold text-ink dark:text-white text-base">选购避雷必看</span>
            <p class="text-xs text-muted mt-1">涵盖专线拓扑、协议优劣与退款风险防坑</p>
          </div>
        </div>
      </section>
    )}

    <!-- Other Articles -->
    <section>
      <div class="mb-6 flex items-center justify-between">
        <h2 class="font-heading text-xl font-bold text-ink dark:text-white">
          最新评测与教程
        </h2>
        <span class="text-xs text-muted font-mono">共 {posts.length} 篇原创文章</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {otherPosts.map((post) => (
          <article class="rounded-2xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-6 flex flex-col justify-between hover:shadow-md transition-all">
            <div>
              <div class="flex items-center justify-between mb-3 text-xs">
                <span class="font-bold text-moss dark:text-coral-bright">{post.data.category}</span>
                <span class="text-muted font-mono">{post.data.readingTime}</span>
              </div>
              <h3 class="font-heading text-lg font-bold text-ink dark:text-white mb-2">
                <a href={`/blog/${post.id}`} class="hover:text-moss dark:hover:text-coral-bright">
                  {post.data.title}
                </a>
              </h3>
              <p class="text-xs text-muted leading-relaxed line-clamp-3 mb-4">
                {post.data.description}
              </p>
            </div>
            <div class="pt-4 border-t border-line/40 dark:border-white/5 flex items-center justify-between text-xs">
              <time class="text-muted font-mono" datetime={post.data.publishedAt.toISOString()}>
                {post.data.publishedAt.toISOString().split('T')[0]}
              </time>
              <a href={`/blog/${post.id}`} class="font-bold text-moss dark:text-emerald-400 hover:underline">
                阅读文章 →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
