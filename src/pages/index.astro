        >
          <span>查看完整排行榜单与细分维度</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {top10Brands.map((brand) => (
          <BrandCard brand={brand} />
        ))}
      </div>
    </div>
  </section>

  <!-- Real Speedtest Showcase Gallery -->
  <section class="py-16 border-b border-line dark:border-white/10 bg-paper/60 dark:bg-black/20">
    <div class="container">
      <div class="max-w-2xl mb-10">
