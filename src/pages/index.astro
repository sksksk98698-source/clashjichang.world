            <span>进入免费与平替专题</span>
            <span>→</span>
          </span>
        </a>

        <a
          href="/tools"
          class="group rounded-2xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-6 hover:border-moss hover:shadow-xl transition-all flex flex-col justify-between"
