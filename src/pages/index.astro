---
import BaseLayout from '@layouts/BaseLayout.astro';
import BrandCard from '@components/BrandCard.astro';
import brandsData from '../data/brands.json';
import clientsData from '../data/clients.json';

const allBrands = brandsData;
const featuredBrand = allBrands.find((b) => b.isFeatured) || allBrands[0];
const top10Brands = allBrands.slice(0, 10);
const testedBrands = allBrands.filter((b) => b.speedtestImg).slice(0, 8);

const faqList = [
  {
    q: '什么是 IPLC / IEPL 专线机场？与普通公网中转有什么本质区别？',
    a: 'IPLC（国际私有租用线路）与 IEPL（国际以太网专线）属于点对点的企业级内网跨境专线，数据在境内入口服务器加密后直接走专线光缆跨境，不经过公网 GFW 审查节点。相比普通公网中转，专线具有“晚高峰不丢包、无封锁断连风险、延迟极低且极度稳定”的特性，尤其适合外贸办公、ChatGPT/Claude 交互及 4K 高码率视频播放。'
  },
  {
    q: '为什么部分机场节点无法正常解锁 ChatGPT 或 Claude？',
    a: 'OpenAI 与 Anthropic 会定期封禁公网数据中心（如 AWS、Linode、Cloudflare）的 ASN IP。优质机场会采用原生家庭宽带住宅 IP 或经过清洗的广播 IP 落地。当遇到 AI 报错时，通常需要切换至标有“原生”或“解锁”的香港、日本、新加坡或美国节点。'
  },
  {
    q: '为什么 clashjichang.world 第一主推“光速云”机场？',
    a: '光速云自 2020 年起稳定运营超过 4 年，技术架构采用“IEPL专线 + 企业级内网专线”双线路，协议采用抗封锁性极佳的 VLESS。其入门价格低至 99元/年（折合每月仅约 8 元），且独家提供 ¥147元/247GB 不限时永久不过期套餐，实测香港节点下载突破 520Mbps，晚高峰表现与性价比在 42 家机场中名列前茅。'
  },
  {
    q: '新手使用 Clash 客户端该如何配置机场订阅？',
    a: '复制机场用户中心提供的“Clash 订阅链接”或“通用订阅链接”；打开 Clash Verge Rev 或 FlClash，点击「配置/Profiles」界面粘贴链接并下载；下载成功后右键激活该配置，在「代理/Proxies」中选择「Rule 规则分流」，并在「设置」中开启系统代理（或 TUN 模式）即可畅快上网。'
  },
  {
    q: '2026 年选购便宜机场有哪些避坑建议？',
    a: '第一，警惕低于 5 元且承诺“独享千兆专线”的年付机场，多为公网直连超卖；第二，优先选择支持月付或提供小额试用的品牌，晚高峰（20:00 - 23:00）实测稳定后再续费；第三，注意查看退款政策，很多机场特惠套餐不支持退款。'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqList.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
};
---

<BaseLayout
  title="Clash机场评测导航 | 2026 IPLC/IEPL专线节点与42家机场品牌库"
  description="clashjichang.world 收录42家主流机场品牌真实参数、16+份节点测速报告与全平台客户端下载指南。第一主推光速云IEPL专线，月均低至8元起。"
  schema={faqSchema}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-16 sm:py-24 border-b border-line dark:border-white/10 bg-gradient-to-b from-moss/5 via-transparent to-transparent">
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-moss/30 bg-moss/10 px-3.5 py-1 text-xs font-semibold text-moss dark:text-emerald-300 mb-6">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>2026 最新测速更新 · 收录 42 家主流机场品牌</span>
