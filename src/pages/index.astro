              <div class="p-3 border-b border-line dark:border-white/10 flex items-center justify-between bg-paper dark:bg-black/20">
                <span class="font-mono text-xs font-bold text-ink dark:text-white flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  光速云节点测速实测
                </span>
                <span class="text-[11px] text-muted font-mono">2026 实测版</span>
              </div>
              <a href="/images/speedtest/光速云-节点测速实测.png" target="_blank" class="block relative group/preview">
                <img
                  src="/images/speedtest/光速云-节点测速实测.png"
                  alt="光速云节点真实测速报告"
                  width="800"
                  height="450"
                  class="w-full h-56 object-cover object-top transition-transform duration-300 group-hover/preview:scale-105"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover/preview:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-bold">
                  点击查看原始测速高清大图 🔍
                </div>
              </a>
              <div class="p-3.5 bg-paper/50 dark:bg-black/30 grid grid-cols-3 gap-2 text-center text-xs">
                <div>
                  <span class="text-muted block text-[10px]">香港延迟</span>
                  <span class="font-bold text-emerald-600 dark:text-emerald-400 font-mono">22ms</span>
                </div>
                <div>
                  <span class="text-muted block text-[10px]">最高下载</span>
                  <span class="font-bold text-emerald-600 dark:text-emerald-400 font-mono">529Mbps</span>
                </div>
                <div>
                  <span class="text-muted block text-[10px]">流媒体</span>
                  <span class="font-bold text-ink dark:text-white font-mono">4K 秒开</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Top 10 Ranked Airport Brands Grid -->
  <section class="py-16 border-b border-line dark:border-white/10">
    <div class="container">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <span class="text-xs font-bold text-moss dark:text-coral-bright uppercase tracking-wider">
            2026 Ranking
          </span>
          <h2 class="font-heading text-2xl sm:text-4xl font-black text-ink dark:text-white mt-1">
            Top 10 梯队机场推荐榜
