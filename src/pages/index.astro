          Evidence Based Reviews
        </span>
        <h2 class="font-heading text-2xl sm:text-4xl font-black text-ink dark:text-white mt-1">
          节点测速实测报告展厅
        </h2>
        <p class="text-sm text-muted mt-2">
          挂载 16+ 份 2026-08-11 实测大图（MAI-TEST-BOT 实测工具）。绝不虚标、绝不篡改测试时间与原始数值。
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {testedBrands.map((b) => (
          <a
            href={`/brands/${b.slug}#speedtest`}
            class="group rounded-2xl border border-line dark:border-white/10 overflow-hidden bg-white dark:bg-[#102a2b] hover:shadow-xl transition-all hover:-translate-y-1 block"
          >
            <div class="relative h-44 overflow-hidden bg-black/5">
              <img
                src={b.speedtestImg}
                alt={`${b.name} 节点测速截图`}
                width="600"
                height="360"
                class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-3">
                <span class="text-xs font-bold text-white font-mono flex items-center justify-between w-full">
                  <span>{b.name}</span>
                  <span class="text-[10px] text-emerald-300 font-normal">TOP {b.rank}</span>
                </span>
              </div>
            </div>
            <div class="p-3 flex items-center justify-between gap-2 text-xs">
              <span class="text-muted font-mono truncate">{b.lineType}</span>
              <span class="text-moss dark:text-emerald-400 font-semibold group-hover:underline shrink-0">查看实测 →</span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a
          href="/speedtest"
          class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] hover:border-moss px-6 py-3 text-sm font-bold text-ink dark:text-white transition-all inline-block"
        >
          查看全部 16 家机场测速对比与分析报告 →
        </a>
      </div>
    </div>
  </section>

  <!-- Third Party Clients Quick Section -->
  <section class="py-16 border-b border-line dark:border-white/10">
    <div class="container">
      <div class="max-w-2xl mb-10">
        <span class="text-xs font-bold text-moss dark:text-coral-bright uppercase tracking-wider">
          Download & Setup
        </span>
        <h2 class="font-heading text-2xl sm:text-4xl font-black text-ink dark:text-white mt-1">
          主流代理客户端大全
        </h2>
        <p class="text-sm text-muted mt-2">
          涵盖 Windows、Android、iOS 和 macOS 全平台主流客户端，附开源官方下载地址与配置指南。
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {clientsData.map((cat) => (
          <div class="rounded-2xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-heading text-lg font-bold text-ink dark:text-white">
                  {cat.category.split(' ')[0]}
                </h3>
                <span class="text-xs text-muted font-mono">{cat.items.length} 款软件</span>
              </div>
              <p class="text-xs text-muted mb-4 leading-relaxed line-clamp-2">
                {cat.tagline}
              </p>
              <ul class="space-y-2 mb-4">
                {cat.items.slice(0, 3).map((item) => (
                  <li class="flex items-center justify-between text-xs py-1 border-b border-line/40 dark:border-white/5">
                    <span class="font-semibold text-ink dark:text-gray-200">{item.name}</span>
                    <span class="text-[10px] text-moss dark:text-emerald-400 bg-moss/10 px-1.5 py-0.5 rounded font-mono">
                      {item.badge}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <a
              href={`/clients#${cat.id}`}
              class="rounded-xl border border-line dark:border-white/10 bg-paper dark:bg-white/5 hover:border-moss text-center py-2 text-xs font-bold text-moss dark:text-emerald-400 transition-colors block"
            >
              查看下载与教程 →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 Monograph SEO/GEO Topic Cluster Hub Cards -->
  <section class="py-16 border-b border-line dark:border-white/10 bg-paper/60 dark:bg-black/20">
    <div class="container">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <span class="text-xs font-bold text-moss dark:text-coral-bright uppercase tracking-wider">
