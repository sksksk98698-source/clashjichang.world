              </div>
              <div class="rounded-xl border border-line dark:border-white/10 bg-white/70 dark:bg-white/5 p-3">
                <span class="text-xs text-muted block">极速 IPLC 版</span>
                <span class="text-base font-black text-ink dark:text-white font-mono">¥25/月</span>
                <span class="text-[11px] text-muted block">168GB/月 2.5Gbps</span>
              </div>
            </div>

            <div class="mt-6 flex flex-wrap items-center gap-4">
