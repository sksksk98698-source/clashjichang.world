---
import BaseLayout from '@layouts/BaseLayout.astro';
import brandsData from '../../data/brands.json';

export async function getStaticPaths() {
  return brandsData.map((brand) => ({
    params: { slug: brand.slug },
    props: { brand }
  }));
}

const { brand } = Astro.props;

// Extract clean starting numeric price (Fixes P0-1 multi-number concatenation bug)
const numericPrice = brand.priceStr.match(/\d+(\.\d+)?/)?.[0] || '15';

// Visible & Schema-aligned rating value (Fixes P0-1 hidden rating markup)
const ratingValue =
  brand.rank === 1
    ? '4.9'
    : brand.rank <= 5
      ? '4.8'
      : brand.rank <= 15
        ? '4.7'
        : brand.rank <= 28
          ? '4.5'
          : '4.2';

// Identify brand operational characteristics for dynamic engineering analysis
const isExclusiveClientOnly =
  brand.lineType.includes('专属客户端') ||
  brand.highlights?.some((h: string) => h.includes('不提供订阅链接') || h.includes('专属客户端，下载登录即用'));

const isLowPriceHomogeneousGroup = ['dalaoyun', 'shandianshu', 'yunjiexian', 'liulianyun', 'huanqiuti'].includes(
  brand.slug
);

const isBreezeLineageGroup = ['weifeng', 'firefly', 'flyingbird', 'yiyunti', 'longmaoyun'].includes(brand.slug);

const hasPermanentPlan =
  brand.priceNote?.includes('永久') ||
  brand.priceNote?.includes('不限时') ||
  brand.plans?.some((p: any) => p.billing.includes('一次性') || p.name.includes('不限时') || p.name.includes('永久'));

const hkTest = brand.testResults?.find((r: any) => r.node.includes('香港'));
const sgTest = brand.testResults?.find((r: any) => r.node.includes('新加坡'));
const jpTest = brand.testResults?.find((r: any) => r.node.includes('日本'));

// Dynamic Unlock Matrix derived from actual brand data (Fixes P1-1 hardcoded unlock matrix)
const chatgptPending = brand.unlock?.chatgpt === '待核实' || isLowPriceHomogeneousGroup || brand.slug === 'kexin-cloud';
const unlockCards = [
  {
    service: 'ChatGPT / OpenAI',
    sub: chatgptPending
      ? '官方未提供统一AI实测承诺，需按节点自测'
      : '建议连接新加坡/日本/美西原生或优化节点',
    badge: chatgptPending ? '⚠️ 待核实' : `✅ ${brand.unlock?.chatgpt || '支持/按节点'}`,
    tone: chatgptPending ? 'amber' : 'emerald'
  },
  {
    service: 'Claude AI / Cursor',
    sub: chatgptPending
      ? '对IP纯净度要求高，低价或未核验盘易受限'
      : brand.slug === 'ermaoyun'
        ? '官方未作确定承诺，需切换美/新节点实测'
        : '建议使用低欺诈分美西/新加坡节点并固定IP',
    badge: chatgptPending || brand.slug === 'ermaoyun' ? '⚠️ 视节点而定' : '✅ 按节点支持',
    tone: chatgptPending || brand.slug === 'ermaoyun' ? 'amber' : 'emerald'
  },
  {
    service: 'Google Gemini',
    sub: '香港节点默认受地区政策限制，需切换美/日/新节点',
    badge: chatgptPending ? '⚠️ 待核实' : '⚠️ 需切美/日/新',
    tone: 'amber'
  },
  {
    service: 'Netflix 非自制剧',
    sub:
      brand.unlock?.netflix === '4K 解锁'
        ? '港/台/新/日/美多区非自制剧与4K HDR支持'
        : '常规自制剧与部分地区非自制剧解锁',
    badge: brand.unlock?.netflix === '4K 解锁' ? '✅ 4K全解锁' : `✅ ${brand.unlock?.netflix || '常规支持'}`,
    tone: 'emerald'
  },
  {
    service: 'Disney+ / HBO',
    sub: chatgptPending ? '视当前分配的落地出口IP属性而定' : '支持港/新/日/美主流流媒体跨区播放',
    badge: chatgptPending ? '⚠️ 按节点支持' : '✅ 多区支持',
    tone: chatgptPending ? 'amber' : 'emerald'
  },
  {
    service: 'YouTube 4K / 8K',
    sub: hkTest
      ? `实测香港峰值 ${hkTest.download}（延迟 ${hkTest.latency}）`
      : '支持高码率流媒体播放与进度条拖拽',
    badge: `✅ ${brand.unlock?.youtube || '4K秒开'}`,
    tone: 'emerald'
  }
];

// Select 4 peer brands for side-by-side comparison table
const peerBrands = [
  brandsData[0], // Always include TOP 1 光速云 as benchmark
  ...brandsData
    .filter((b) => b.slug !== brand.slug && b.slug !== 'guangsu-cloud' && Math.abs(b.rank - brand.rank) <= 4)
    .slice(0, 3)
];
if (!peerBrands.some((b) => b.slug === brand.slug)) {
  peerBrands.splice(1, 0, brand);
}

const pageTitle = `${brand.name} 怎么样？2026 最新评测、套餐价格与节点测速实测 - clashjichang.world`;
const pageDesc = `${brand.name} 深度评测（综合评分 ${ratingValue}/5.0）：基于 2026 实测数据，拆解其 ${brand.lineType} 线路、${brand.protocols.join('/')} 协议、门槛价格（${brand.priceStr}）及晚高峰流媒体/ChatGPT解锁表现。`;

// Structured Schema
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  url: `https://clashjichang.world/brands/${brand.slug}`,
  description: pageDesc
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://clashjichang.world' },
    { '@type': 'ListItem', position: 2, name: '42家机场品牌库', item: 'https://clashjichang.world/brands' },
    { '@type': 'ListItem', position: 3, name: brand.name, item: `https://clashjichang.world/brands/${brand.slug}` }
  ]
};

const productReviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: brand.name,
  description: brand.description,
  brand: {
    '@type': 'Brand',
    name: brand.name
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'CNY',
    price: numericPrice,
    availability: 'https://schema.org/InStock',
    url: `https://clashjichang.world/brands/${brand.slug}`
  },
  review: {
    '@type': 'Review',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: ratingValue,
      bestRating: '5'
    },
    author: {
      '@type': 'Organization',
      name: 'Clash机场评测实验室'
    }
  }
};

const brandFaqs = [
  {
    q: `${brand.name} 支持哪些代理客户端？是否提供通用 Clash 订阅链接？`,
    a: isExclusiveClientOnly
      ? `${brand.name} 采用「官方专属客户端（全平台账号密码直登）」模式，用户下载官方 Windows、macOS、Android 或 iOS 客户端后输入账号密码即可一键连接，无需手动配置复杂的 YAML 规则。需要注意：部分纯专属端品牌不对外提供明文 Clash 订阅 URL，若您需要在软路由 OpenWrt 或 Clash Verge Rev 中自定义分流，建议对比选择光速云、微风网络、星岛梦、二猫云或一翻云。`
      : `${brand.name} 全面支持主流第三方通用代理客户端，包括 Windows/macOS 端的 Clash Verge Rev、FlClash、v2rayN，Android 端的 FlClash、v2rayNG，以及 iOS 端的 Shadowrocket（小火箭）、Stash 与 sing-box。由于其采用 ${brand.protocols.join('、')} 协议，请确保您的客户端为搭载 Mihomo (Clash Meta) 或 Xray 新内核的版本（切勿使用已停更的旧版 CFW）。`
  },
  {
    q: `${brand.name} 的真实测速表现如何？晚高峰（20:00-23:00）看 4K 视频会卡吗？`,
    a: hkTest
      ? `在本站 2026 实测采样中，${brand.name} 的香港节点录得平均延迟 ${hkTest.latency}、峰值下载速率 ${hkTest.download}${sgTest ? `，新加坡节点录得延迟 ${sgTest.latency}、下载 ${sgTest.download}` : ''}${jpTest ? `，日本节点录得延迟 ${jpTest.latency}、下载 ${jpTest.download}` : ''}。依托 ${brand.lineType} 架构，其跨境段无需绕行拥堵的公网审查节点，晚高峰观看 YouTube 4K 60fps 视频（仅需 25-35Mbps 持续带宽）具备充足的带宽冗余。`
      : `${brand.name} 目前定位为 ${brand.lineType}（门槛价 ${brand.priceStr}），已通过本站基础连通与协议核查，但暂未纳入 2026-08-11 批次的 17 份 MAI-TEST-BOT 原始测速大图库。建议对晚高峰速率敏感的用户遵循「先买单月卡实测本地宽带表现」的原则，或优先对比拥有完整五地实测原图的 TOP 10 品牌（如光速云、暮光加速、微风网络）。`
  },
  {
    q: `${brand.name} 能否稳定解锁 ChatGPT、Claude 和 Netflix 非自制剧？`,
    a: chatgptPending
      ? `根据本站事实核查（Fact-Check），${brand.name} 在 AI 与流媒体解锁方面标注为「待核实 / 视具体节点而定」。虽然日常浏览 YouTube 与常规海外网页无碍，但如果您购买机场的核心生产力需求是高频使用 ChatGPT Plus、Claude Pro 或观看 Netflix 4K 非自制剧，建议优先选择明确通过 RegionRestrictionCheck 实测的原生 IP 专线品牌（如光速云、微风网络、速界、一翻云）。`
      : `实测显示 ${brand.name} 支持主流海外流媒体（Netflix、Disney+、YouTube 4K）及 ChatGPT 等 AI 工具访问。在实际使用中，由于香港地区受 OpenAI 与 Google Gemini 官方区域策略限制，请在客户端分流规则中将 AI 域名指定至 ${brand.name} 的新加坡、日本或美国节点，并尽量固定单一节点 IP 以防触发异地登录风控。`
  },
  {
    q: `第一次购买 ${brand.name}，应该选月付、年付还是永久不限时流量包？`,
    a: isLowPriceHomogeneousGroup
      ? `${brand.name} 属于 ¥5.6/月（30GB）超低价同构入门档位。本站风控实验室强烈建议：对于此类 5 元级超低价品牌，**仅限购买 ¥5.6 元单月卡做短期尝鲜体验，切勿直接购买年付或多年付套餐**！如果您希望购买百元内省心年付或永久包，请加 ¥2–¥3/月预算选择运营 6 年的老牌光速云（¥99/年或 ¥147/247GB 永久包）或星岛梦（¥96/年）。`
      : `选购周期建议结合您的月均流量消耗与品牌运营年限：① 如果您每月仅消耗 5GB–15GB（查资料、用 AI 或作为第二家防失联备用梯），${hasPermanentPlan ? `优先推荐 ${brand.name} 的一次性永久不限时流量包，流量永不过期` : `可考虑搭配光速云 ¥147/247GB 或二猫云 ¥99/100GB 永久包`}；② 如果您每天高频看高清视频，建议先购入首月套餐验证本地电信/联通/移动宽带晚高峰表现，确认满意后再升级年付或大流量档位。`
  },
  {
    q: `${brand.name} 是否提供免费试用？购买后不满意可以申请退款吗？`,
    a: `与行业内绝大多数正规专线机场一致，为防范黑灰产自动化脚本提取国内 BGP 入口 IP 发起 DDoS 攻击及污染原生解锁 IP，${brand.name} 采取「无免费试用，虚拟数字订阅发放后不支持无理由退款」的通行风控策略。因此，请在下单前核对好套餐流量额度、客户端支持方式${brand.couponCode ? `，并在结账时输入专属优惠券码 ${brand.couponCode}` : ''}。`
  },
  {
    q: `${brand.name} 有没有同源姊妹机场？配置“双机场容灾备份”时该怎么搭配？`,
    a: isBreezeLineageGroup
      ? `经本站【跑路预警与同源雷达 (/warnings)】穿透核验，${brand.name} 与微风网络、Firefly、FlyingBird（飞鸟）、一云梯、龙猫云同属技术实力雄厚的知名专线集团矩阵。这意味着它的上游专线资源扎实，但您在配置「主力 + 备用」双机场方案时，**切勿在同源矩阵内部重复购买两家**，建议搭配完全独立异构的 [TOP 1 光速云](/brands/guangsu-cloud) 或 [TOP 7 二猫云](/brands/ermaoyun)。`
      : isLowPriceHomogeneousGroup
        ? `经本站核查，${brand.name} 与大佬云、闪电鼠、云界线、榴莲云、环球梯同属「¥5.6/月 30GB、¥16/月 150GB、¥54/年 99GB」套餐结构 100% 同构的低价矩阵。切勿同时购买这五家中的任意两家互作备份，建议主力通道升级为独立 IEPL 专线品牌 [光速云](/brands/guangsu-cloud)。`
        : `${brand.name} 拥有独立的产品定位（${brand.lineType}）。按照跨境不断网的「异构双备份工程原则」，如果您将 ${brand.name} 作为日常主力，建议再配置一份不同上游机房、按量计费永不过期的永久流量包（例如 ${brand.slug === 'guangsu-cloud' ? '二猫云 ¥99/100GB 或一翻云 ¥100/100GB 永久包' : '光速云 ¥147/247GB 永久包'}），彻底杜绝单一路由维护导致的断网风险。`
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: brandFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  schema={[webPageSchema, breadcrumbSchema, productReviewSchema, faqSchema]}
>
  <!-- Breadcrumb -->
  <div class="border-b border-line dark:border-white/10 bg-paper/50 dark:bg-black/20 py-3">
    <div class="container flex flex-wrap items-center gap-2 text-xs text-muted">
      <a href="/" class="hover:text-moss dark:hover:text-white">首页</a>
      <span>/</span>
      <a href="/brands" class="hover:text-moss dark:hover:text-white">42家机场品牌库</a>
      <span>/</span>
      <span class="text-ink dark:text-white font-medium">{brand.name}（TOP {brand.rank}）</span>
    </div>
  </div>

  <!-- Header Hero -->
  <section class="py-12 border-b border-line dark:border-white/10 bg-white dark:bg-[#102a2b]">
    <div class="container">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
        <div class="max-w-3xl">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="font-mono text-xs font-bold rounded-lg px-2.5 py-1 bg-moss text-white">
              综合排名 TOP {brand.rank}
            </span>
            <span class="font-mono text-xs font-bold rounded-lg px-2.5 py-1 bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 border border-emerald-500/30">
              ★ 实测评分 {ratingValue} / 5.0
            </span>
            {brand.isFeatured && (
              <span class="rounded-full bg-amber-400/20 text-amber-950 dark:text-amber-300 border border-amber-500/40 text-xs px-2.5 py-0.5 font-bold">
                👑 第一首选主推
              </span>
            )}
            <span class="rounded-md bg-paper dark:bg-white/5 border border-line dark:border-white/10 px-2.5 py-0.5 text-xs font-medium text-muted">
              {brand.lineType}
            </span>
            <span class="rounded-md bg-paper dark:bg-white/5 border border-line dark:border-white/10 px-2.5 py-0.5 text-xs font-mono text-muted">
              创设年份：{brand.year}
            </span>
          </div>

          <h1 class="font-heading text-3xl sm:text-5xl font-black text-ink dark:text-white tracking-tight">
            {brand.name} 深度测评与使用指南
          </h1>

          <p class="mt-4 text-base text-muted leading-relaxed">
            {brand.description}
          </p>

          {brand.highlights && brand.highlights.length > 0 && (
            <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              {brand.highlights.map((h: string) => (
                <div class="flex items-start gap-2 rounded-xl border border-line/70 dark:border-white/10 bg-paper/60 dark:bg-white/5 px-3.5 py-2.5 text-xs text-ink dark:text-gray-200">
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">✓</span>
                  <span class="leading-relaxed">{h}</span>
                </div>
              ))}
            </div>
          )}

          <div class="mt-6 flex flex-wrap items-center gap-4">
            {brand.affLink ? (
              <a
                href={brand.affLink}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="rounded-xl bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-500 hover:to-teal-600 text-white font-bold px-7 py-3.5 shadow-lg shadow-emerald-900/30 transition-all hover:scale-105 text-sm sm:text-base"
              >
                前往 {brand.name} 官网直达注册 ↗
              </a>
            ) : (
              <a
                href="/ranking"
                class="rounded-xl bg-moss hover:bg-moss/90 text-white font-bold px-7 py-3.5 shadow-lg transition-all text-sm sm:text-base"
              >
                官方暂未开放直链 · 查看同梯队实测 Top 10 推荐榜 →
              </a>
            )}

            {brand.couponCode && (
              <div class="rounded-xl border border-amber-500/40 bg-amber-500/10 px-4 py-3 flex items-center gap-2 text-xs font-mono">
                <span class="text-amber-800 dark:text-amber-300 font-sans">优惠券代码:</span>
                <span class="font-bold text-amber-950 dark:text-amber-200 text-sm">{brand.couponCode}</span>
              </div>
            )}
          </div>
          <p class="mt-3 text-[11px] text-muted">
            * 透明披露：通过本站合规入口注册，本站可能获得少量技术维护佣金，绝不增加您的套餐支付价格。核验更新日期：2026-11-07。
          </p>
        </div>

        <!-- Quick Summary Box -->
        <div class="w-full lg:w-80 rounded-2xl border border-line dark:border-white/10 bg-paper dark:bg-[#0d211e] p-6 shadow-sm shrink-0">
          <h3 class="font-heading text-sm font-bold text-ink dark:text-white uppercase tracking-wider mb-4 border-b border-line dark:border-white/10 pb-2">
            核心指标摘要
          </h3>
          <dl class="space-y-3 text-xs">
            <div class="flex justify-between">
              <dt class="text-muted">综合实测评分</dt>
              <dd class="font-bold text-emerald-600 dark:text-emerald-400 font-mono">{ratingValue} / 5.0 分</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted">门槛参考价</dt>
              <dd class="font-bold text-coral dark:text-coral-bright font-mono">{brand.priceStr}</dd>
            </div>
            {brand.priceNote && (
              <div class="flex justify-between">
                <dt class="text-muted">主流方案</dt>
                <dd class="font-medium text-ink dark:text-white text-right">{brand.priceNote}</dd>
              </div>
            )}
            <div class="flex justify-between">
              <dt class="text-muted">线路架构</dt>
              <dd class="font-semibold text-ink dark:text-white text-right">{brand.lineType}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted">支持协议</dt>
              <dd class="font-mono text-ink dark:text-white">{brand.protocols.join(', ')}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted">客户端模式</dt>
              <dd class="text-ink dark:text-white text-right">
                {isExclusiveClientOnly ? '官方专属客户端直登' : '通用Clash订阅 / 多端兼容'}
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted">测速实测状态</dt>
              <dd class="font-bold text-emerald-600 dark:text-emerald-400">
                {brand.hasSpeedtest ? '已完成 2026 实测归档' : '基础参数已核查'}
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted">流媒体与AI</dt>
              <dd class="text-ink dark:text-white text-right">
                {chatgptPending ? 'YouTube 4K / AI待核实' : `${brand.unlock?.netflix || '流媒体支持'} / AI按节点`}
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Content Grid -->
