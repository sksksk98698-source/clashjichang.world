---
import BaseLayout from '@layouts/BaseLayout.astro';
import brandsData from '../../data/brands.json';
import speedtestContent from '../../data/speedtest-content.json';

const testedBrands = brandsData.filter((b) => b.speedtestImg);
const pageTitle = speedtestContent.meta.title;
const pageDesc = speedtestContent.meta.description;

const slugToReviewKey: Record<string, keyof typeof speedtestContent.brandReviews> = {
  'guangsu-cloud': 'guangsu',
  'muguang': 'muguang',
  'feimao': 'feimao',
  'weifeng': 'weifeng',
  'xingdaomeng': 'xingdaomeng',
  'ermaoyun': 'ermaoyun',
  'weitu-cloud': 'weitu',
  'yuzhou-cloud': 'yuzhou',
  'u1s1': 'u1s1',
  'lingmao-network': 'lingmao',
  'jilian-cloud': 'jilian',
  'guangnianti': 'guangnianti',
  'yifanyun': 'yifanyun',
  'sogo-cloud': 'sogo',
  'kexin-cloud': 'kexin',
  'sujie': 'sujie',
  'quanqiuyun': 'quanqiuyun'
};

function formatInlineMarkdown(text: string): string {
  if (!text) return '';
  return text
    .replace(/\*\*(.+?)\*\*/g, '<strong class="font-bold text-ink dark:text-white">$1</strong>')
    .replace(/`([^`]+)`/g, '<code class="rounded bg-moss/10 dark:bg-white/10 px-1.5 py-0.5 font-mono text-[11px] text-moss dark:text-emerald-300 break-all">$1</code>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="font-semibold text-moss dark:text-emerald-300 underline decoration-moss/40 underline-offset-4 hover:text-coral transition-colors">$1</a>');
}

const combinedSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: 'https://clashjichang.world/' },
        { '@type': 'ListItem', position: 2, name: '2026 机场节点真实测速证据库', item: 'https://clashjichang.world/speedtest' }
      ]
    },
    {
      '@type': 'TechArticle',
      headline: speedtestContent.meta.h1,
      description: speedtestContent.meta.description,
      datePublished: '2026-08-11',
      dateModified: speedtestContent.meta.updatedAt,
      author: {
        '@type': 'Organization',
        name: speedtestContent.meta.author,
        url: 'https://clashjichang.world/'
      },
      publisher: {
        '@type': 'Organization',
        name: 'Clash机场评测网',
        url: 'https://clashjichang.world/'
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': 'https://clashjichang.world/speedtest'
      }
    },
    {
      '@type': 'Dataset',
      name: '2026 机场节点 MAI-TEST-BOT 真实测速原图与五地延迟吞吐数据集',
      description: '包含 2026-08-11 CST 批次 17 份 1122x1402 原始测速 PNG（含 SHA256 校验）与 2026-10-19 15 家主力机场港/台/新/日/美五地延迟下载采样。',
      temporalCoverage: '2025-06-21/2026-10-19',
      creator: {
        '@type': 'Organization',
        name: speedtestContent.meta.author
      }
    },
    {
      '@type': 'FAQPage',
      mainEntity: speedtestContent.faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  schema={combinedSchema}
>
  <!-- Page Hero & Observatory Metadata Header -->
  <header class="py-10 sm:py-14 border-b border-line dark:border-white/10 bg-paper/60 dark:bg-black/20">
    <div class="container max-w-6xl">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs text-muted flex flex-wrap items-center gap-1.5">
        <a href="/" class="hover:text-moss transition-colors">首页</a>
        <span>/</span>
        <span class="text-ink dark:text-white font-semibold">节点测速实测证据库</span>
      </nav>

      <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-moss/30 bg-moss/10 px-3.5 py-1 text-xs font-semibold text-moss dark:text-emerald-300 mb-4">
        <span>测速批次：2026-08-11 CST 原图 & 2026-10-19 五地采样</span>
        <span class="opacity-50">|</span>
        <span>SHA256 哈希可溯源 · 零修图实证</span>
      </div>

      <h1 class="font-heading text-2xl sm:text-4xl lg:text-5xl font-black text-ink dark:text-white tracking-tight leading-tight">
        {speedtestContent.meta.h1}
      </h1>

      <p class="mt-4 text-sm sm:text-base text-muted leading-relaxed max-w-4xl">
        {speedtestContent.meta.description}
      </p>

      <!-- Benchmark Observatory KPI Chips -->
      <div class="mt-7 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
        <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-3.5">
          <span class="text-muted block text-[11px]">测试引擎规范</span>
          <span class="font-bold text-ink dark:text-white font-mono">MAI-TEST-BOT 2.0 / miaosu</span>
        </div>
        <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-3.5">
          <span class="text-muted block text-[11px]">原始实证图总数</span>
          <span class="font-bold text-moss dark:text-emerald-400 font-mono">17 份测速原图 + 6 份实况图</span>
        </div>
        <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-3.5">
          <span class="text-muted block text-[11px]">五地横评样本覆盖</span>
          <span class="font-bold text-ink dark:text-white font-mono">15 家新测 + 5 家历史统计</span>
        </div>
        <div class="rounded-xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-3.5">
          <span class="text-muted block text-[11px]">香港专线实测峰值</span>
          <span class="font-bold text-coral dark:text-coral-bright font-mono">529–548 Mbps (21–27ms)</span>
        </div>
      </div>

      <!-- Author, Verification & Update Metadata Bar -->
      <div class="mt-6 pt-5 border-t border-line/60 dark:border-white/10 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-muted">
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">维护团队：</span>
          <span>{speedtestContent.meta.author}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">核验时间轴：</span>
          <span class="font-mono text-moss dark:text-emerald-300">{speedtestContent.meta.verifiedAt}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">最后修订：</span>
          <time datetime={speedtestContent.meta.updatedAt} class="font-mono">{speedtestContent.meta.updatedAt}</time>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">阅读时长：</span>
          <span>{speedtestContent.meta.readingTime}</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content Layout with Sidebar / Collapsible TOC -->
  <div class="container max-w-6xl py-8 sm:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Left/Top TOC Navigation -->
      <aside class="lg:col-span-3 lg:sticky lg:top-20 rounded-2xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-4 sm:p-5 shadow-sm">
        <details class="group lg:open" open>
          <summary class="flex items-center justify-between cursor-pointer list-none font-heading text-sm font-black text-ink dark:text-white">
            <span class="flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-moss dark:bg-emerald-400"></span>
              测速报告章节目录 (TOC)
            </span>
            <span class="text-xs text-muted lg:hidden group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <nav aria-label="页内章节导航" class="mt-3 pt-3 border-t border-line/60 dark:border-white/10">
            <ul class="space-y-1.5 text-xs">
              {speedtestContent.toc.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class="block py-1 px-2 rounded-lg text-muted hover:text-moss dark:hover:text-emerald-300 hover:bg-moss/5 dark:hover:bg-white/5 transition-colors leading-snug"
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-4 pt-3 border-t border-line/60 dark:border-white/10 space-y-1.5">
              <div class="text-[11px] font-bold text-ink dark:text-white">关联专题快链</div>
              <div class="flex flex-wrap gap-1.5 text-[11px]">
                <a href="/brands" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">42家品牌库</a>
                <a href="/ranking" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">Top10榜单</a>
                <a href="/guide" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">专线拓扑原理</a>
                <a href="/clients" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">客户端下载</a>
              </div>
            </div>
          </nav>
        </details>
      </aside>

      <!-- Right Primary Article Column -->
      <article class="lg:col-span-9 space-y-10 min-w-0">

        <!-- Module 0: Direct Answer Box (核心实测结论前置) -->
        <section id="direct-answer" class="scroll-mt-24 rounded-2xl border-2 border-moss/40 dark:border-emerald-500/40 bg-emerald-50/50 dark:bg-[#0d2625] p-5 sm:p-8 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 rounded-md bg-moss px-2.5 py-1 text-[11px] font-bold text-white uppercase tracking-wider">
              ⚡ 核心实测结论前置 · 3 分钟读懂 2026 机场真实吞吐梯度
            </span>
            <span class="text-[11px] font-mono text-muted">Measured Data Executive Summary</span>
          </div>

          <p class="text-xs sm:text-sm text-ink dark:text-white font-medium leading-relaxed mb-5">
            {speedtestContent.directAnswer.summary}
          </p>

          <div class="space-y-4">
            {speedtestContent.directAnswer.points.map((pt) => (
              <div class="rounded-xl border border-moss/20 dark:border-white/10 bg-white/90 dark:bg-black/25 p-4 sm:p-5">
                <h2 class="font-heading text-sm sm:text-base font-black text-moss dark:text-emerald-300 mb-2">
                  {pt.label}
                </h2>
                <p class="text-xs sm:text-sm text-muted leading-relaxed">
                  {pt.content}
                </p>
              </div>
            ))}
          </div>

          <!-- Quick Jump Pills -->
          <div class="mt-5 pt-4 border-t border-moss/20 dark:border-white/10">
            <div class="text-xs font-bold text-ink dark:text-white mb-2.5">按核验目的快速直达数据模块：</div>
            <div class="flex flex-wrap gap-2">
              {speedtestContent.directAnswer.quickNav.map((nav) => (
                <a
                  href={nav.href}
                  class="inline-flex items-center gap-1 rounded-xl border border-moss/30 bg-white dark:bg-white/10 px-3 py-1.5 text-xs font-bold text-moss dark:text-emerald-300 hover:bg-moss hover:text-white transition-colors"
                >
                  <span>{nav.text}</span>
                </a>
              ))}
            </div>
          </div>
        </section>

        <!-- Table 1: 15 Core Brands 5-Region Benchmark Comparison Table -->
        <section id="five-region-table" class="scroll-mt-24 rounded-2xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-5 sm:p-8 space-y-4">
          <div>
            <span class="text-xs font-bold text-moss dark:text-coral-bright uppercase tracking-wider">BENCHMARK TABLE 01 · FIVE-REGION SPEED & LATENCY</span>
            <h2 class="font-heading text-xl sm:text-2xl font-black text-ink dark:text-white mt-1">
              {speedtestContent.fiveRegionTable.caption}
            </h2>
            <p class="mt-2 text-xs text-muted leading-relaxed">
              下表统一汇总了 2026-10-19 采样中 15 家主力机场在五个核心地区（香港、新加坡、台湾、日本、美国）的握手延迟（ms）与下载速率（Mbps），并附带实际起步价格与流媒体/AI 解锁实况。在 375px 手机视口下可左右滑动表格对比全部字段：
            </p>
          </div>

          <div class="overflow-x-auto rounded-xl border border-line dark:border-white/10">
            <table class="w-full text-xs text-left border-collapse min-w-[860px]">
              <thead class="bg-paper dark:bg-black/40 border-b border-line dark:border-white/10 text-ink dark:text-white font-bold">
                <tr>
                  {speedtestContent.fiveRegionTable.headers.map((h) => (
                    <th class="py-3 px-3 whitespace-nowrap">{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody class="divide-y divide-line/50 dark:divide-white/10">
                {speedtestContent.fiveRegionTable.rows.map((r) => (
                  <tr class="hover:bg-paper/40 dark:hover:bg-white/5">
                    <td class="py-3 px-3 font-bold whitespace-nowrap">
                      <a href={`/brands/${r.slug}`} class="text-moss dark:text-emerald-300 hover:underline">
                        {r.brand} →
                      </a>
                    </td>
                    <td class="py-3 px-3 text-muted min-w-[140px]">{r.arch}</td>
                    <td class="py-3 px-3 font-mono font-bold text-emerald-700 dark:text-emerald-300 whitespace-nowrap">{r.hk}</td>
                    <td class="py-3 px-3 font-mono font-semibold text-ink dark:text-white whitespace-nowrap">{r.sg}</td>
                    <td class="py-3 px-3 font-mono text-muted whitespace-nowrap">{r.tw}</td>
                    <td class="py-3 px-3 font-mono text-muted whitespace-nowrap">{r.jp}</td>
                    <td class="py-3 px-3 font-mono text-muted whitespace-nowrap">{r.us}</td>
                    <td class="py-3 px-3 font-mono text-[11px] min-w-[150px]">{r.price}</td>
                    <td class="py-3 px-3 text-muted min-w-[170px]">{r.unlock}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Table 2 & Table 3: Manifest Audit Table & Historical Multi-Node Table -->
        <section id="manifest-audit-table" class="scroll-mt-24 rounded-2xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-5 sm:p-8 space-y-6">
          <div>
            <span class="text-xs font-bold text-moss dark:text-coral-bright uppercase tracking-wider">BENCHMARK TABLE 02 & 03 · PROVENANCE & HISTORICAL ARCHIVES</span>
            <h2 class="font-heading text-xl sm:text-2xl font-black text-ink dark:text-white mt-1">
              原始测速截图归档元数据核验表 & 历史多节点统计档案表
            </h2>
            <p class="mt-2 text-xs text-muted leading-relaxed">
              为践行“专业网络测试实验室”的数据透明准则，【表 2】完整公开了 `speedtest-manifest.json` 中 17 张原图的精确生成时刻（突出标注 **21:04–22:46 晚高峰样本**）与时间戳置信度；【表 3】则单独列出 WgetCloud、白月光、山水云、CyberGuard 与灵动云的历史多节点平均值，严格区分数据批次：
            </p>
          </div>

          <!-- Table 2 -->
          <div>
            <div class="text-xs font-bold text-ink dark:text-white mb-2">
              {speedtestContent.manifestAuditTable.caption}
            </div>
            <div class="overflow-x-auto rounded-xl border border-line dark:border-white/10">
              <table class="w-full text-xs text-left border-collapse min-w-[780px]">
                <thead class="bg-paper dark:bg-black/40 border-b border-line dark:border-white/10 text-ink dark:text-white font-bold">
                  <tr>
                    {speedtestContent.manifestAuditTable.headers.map((h) => (
                      <th class="py-3 px-3 whitespace-nowrap">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-line/50 dark:divide-white/10">
                  {speedtestContent.manifestAuditTable.rows.map((r) => (
                    <tr class="hover:bg-paper/40 dark:hover:bg-white/5">
                      <td class="py-3 px-3 font-bold whitespace-nowrap">
                        <a href={`/brands/${r.slug}`} class="text-moss dark:text-emerald-300 hover:underline">{r.brand}</a>
                      </td>
                      <td class="py-3 px-3 font-mono text-[11px] text-muted whitespace-nowrap">{r.file}</td>
                      <td class="py-3 px-3 font-mono text-[11px] text-ink dark:text-white whitespace-nowrap">{r.time}</td>
                      <td class="py-3 px-3 font-semibold whitespace-nowrap">{r.period}</td>
                      <td class="py-3 px-3 font-mono text-[11px]">{r.proto}</td>
                      <td class="py-3 px-3 font-mono text-[11px] text-muted">{r.tool}</td>
                      <td class="py-3 px-3 text-muted min-w-[170px]">{r.note}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Table 3 -->
          <div id="historical-stats-table" class="pt-2">
            <div class="text-xs font-bold text-ink dark:text-white mb-2">
              {speedtestContent.historicalStatsTable.caption}
            </div>
            <div class="overflow-x-auto rounded-xl border border-line dark:border-white/10">
              <table class="w-full text-xs text-left border-collapse min-w-[780px]">
                <thead class="bg-paper dark:bg-black/40 border-b border-line dark:border-white/10 text-ink dark:text-white font-bold">
                  <tr>
                    {speedtestContent.historicalStatsTable.headers.map((h) => (
                      <th class="py-3 px-3 whitespace-nowrap">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-line/50 dark:divide-white/10">
                  {speedtestContent.historicalStatsTable.rows.map((r) => (
                    <tr class="hover:bg-paper/40 dark:hover:bg-white/5">
                      <td class="py-3 px-3 font-bold whitespace-nowrap">
                        <a href={`/brands/${r.slug}`} class="text-moss dark:text-emerald-300 hover:underline">{r.brand} →</a>
                      </td>
                      <td class="py-3 px-3 font-mono text-[11px] whitespace-nowrap">{r.date}</td>
                      <td class="py-3 px-3 text-ink dark:text-white min-w-[140px]">{r.scale}</td>
                      <td class="py-3 px-3 font-mono text-[11px] text-emerald-700 dark:text-emerald-300 min-w-[200px]">{r.metrics}</td>
                      <td class="py-3 px-3 text-muted min-w-[150px]">{r.unlock}</td>
                      <td class="py-3 px-3 text-amber-700 dark:text-amber-400 min-w-[170px]">{r.warning}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- Chapter 1: 17 Real Speedtest PNG Gallery with Individual Evidence Analysis -->
        <section id="speedtest-gallery" class="scroll-mt-24 rounded-2xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-5 sm:p-8 space-y-6">
          <div>
            <span class="text-xs font-bold text-moss dark:text-coral-bright uppercase tracking-wider">CHAPTER 01 · 17 RAW SPEEDTEST SCREENSHOTS</span>
            <h2 class="font-heading text-xl sm:text-3xl font-black text-ink dark:text-white mt-1">
              一、17 家机场 MAI-TEST-BOT 原始测速截图与单图深度评析
            </h2>
            <p class="mt-2 text-xs sm:text-sm text-muted leading-relaxed">
              以下集中展示 17 家已完成 `1122×1402` 原始 PNG 测速图归档的品牌。每张卡片均附带本实验室针对该图采样时刻、显示协议、五地实测指标及适用/不适用人群的独立评析。点击图片可在新窗口打开无损大图查验每一行节点：
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {testedBrands.map((brand) => {
              const reviewKey = slugToReviewKey[brand.slug];
              const review = reviewKey ? speedtestContent.brandReviews[reviewKey] : null;
              return (
                <div id={`test-${brand.slug}`} class="rounded-2xl border border-line dark:border-white/10 overflow-hidden bg-paper/30 dark:bg-black/20 shadow-sm flex flex-col justify-between">
                  <div>
                    <div class="p-4 border-b border-line/60 dark:border-white/10 flex items-center justify-between gap-2 bg-white dark:bg-[#102a2b]">
                      <div>
                        <span class="text-[10px] text-moss dark:text-emerald-400 font-mono font-bold block">
                          TOP {brand.rank} · {review ? review.testedAt : '2026-08-11 CST'}
                        </span>
                        <h3 class="font-heading text-base sm:text-lg font-black text-ink dark:text-white">
                          <a href={`/brands/${brand.slug}`} class="hover:text-moss transition-colors">
                            {brand.name} 节点实测报告
                          </a>
                        </h3>
                      </div>
                      <span class="text-xs font-mono font-bold text-coral dark:text-coral-bright text-right shrink-0">
                        {brand.priceStr}
                      </span>
                    </div>

                    <!-- Real speedtest image -->
                    <div class="relative bg-black/5 overflow-hidden border-b border-line/60 dark:border-white/10">
                      <a href={brand.speedtestImg} target="_blank" rel="noopener" class="block group relative">
                        <img
                          src={brand.speedtestImg}
                          alt={`${brand.name} 2026-08-11 MAI-TEST-BOT 节点测速完整原始截图 (1122x1402)`}
                          width="1122"
                          height="1402"
                          class="w-full h-72 object-cover object-top transition-transform duration-300 group-hover:scale-105"
                          loading="lazy"
                          decoding="async"
                        />
