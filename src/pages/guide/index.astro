---
import BaseLayout from '@layouts/BaseLayout.astro';
import guideData from '../../data/guide-content.json';

const pageTitle = guideData.meta.title;
const pageDesc = guideData.meta.description;

function formatInlineMarkdown(text: string): string {
  if (!text) return '';
  return text
    .replace(/\*\*(.+?)\*\*/g, '<strong class="font-bold text-ink dark:text-white">$1</strong>')
    .replace(/`([^`]+)`/g, '<code class="rounded bg-moss/10 dark:bg-white/10 px-1.5 py-0.5 font-mono text-[11px] text-moss dark:text-emerald-300">$1</code>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="font-semibold text-moss dark:text-emerald-300 underline decoration-moss/40 underline-offset-4 hover:text-coral transition-colors">$1</a>');
}

const combinedSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: 'https://clashjichang.world/' },
        { '@type': 'ListItem', position: 2, name: 'IEPL/IPLC专线与协议全解指南', item: 'https://clashjichang.world/guide' }
      ]
    },
    {
      '@type': 'TechArticle',
      headline: guideData.meta.h1,
      description: guideData.meta.description,
      datePublished: '2026-08-11',
      dateModified: guideData.meta.updatedAt,
      author: {
        '@type': 'Organization',
        name: guideData.meta.author,
        url: 'https://clashjichang.world/'
      },
      publisher: {
        '@type': 'Organization',
        name: 'Clash机场评测网',
        url: 'https://clashjichang.world/'
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': 'https://clashjichang.world/guide'
      },
      proficiencyLevel: 'Beginner to Expert'
    },
    {
      '@type': 'FAQPage',
      mainEntity: guideData.faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  schema={combinedSchema}
>
  <!-- Page Hero & Metadata Header -->
  <header class="py-10 sm:py-14 border-b border-line dark:border-white/10 bg-paper/60 dark:bg-black/20">
    <div class="container max-w-6xl">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs text-muted flex flex-wrap items-center gap-1.5">
        <a href="/" class="hover:text-moss transition-colors">首页</a>
        <span>/</span>
        <span class="text-ink dark:text-white font-semibold">专线网络拓扑与代理协议深度指南</span>
      </nav>

      <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-moss/30 bg-moss/10 px-3.5 py-1 text-xs font-semibold text-moss dark:text-emerald-300 mb-4">
        <span>技术深度剖析 · 专著级工程实证手册</span>
        <span class="opacity-50">|</span>
        <span>基于 42 家机场库与 16 份实测原图</span>
      </div>

      <h1 class="font-heading text-2xl sm:text-4xl lg:text-5xl font-black text-ink dark:text-white tracking-tight leading-tight">
        {guideData.meta.h1}
      </h1>

      <p class="mt-4 text-sm sm:text-base text-muted leading-relaxed max-w-4xl">
        {guideData.meta.description}
      </p>

      <!-- Author, Verification & Update Metadata Bar -->
      <div class="mt-6 pt-5 border-t border-line/60 dark:border-white/10 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-muted">
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">维护团队：</span>
          <span>{guideData.meta.author}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">数据核实批次：</span>
          <span class="font-mono text-moss dark:text-emerald-300">{guideData.meta.verifiedAt}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">最后修订：</span>
          <time datetime={guideData.meta.updatedAt} class="font-mono">{guideData.meta.updatedAt}</time>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-ink dark:text-white">阅读时长：</span>
          <span>{guideData.meta.readingTime}</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content Layout with Sidebar / Collapsible TOC -->
  <div class="container max-w-6xl py-8 sm:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Left/Top TOC Navigation -->
      <aside class="lg:col-span-3 lg:sticky lg:top-20 rounded-2xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-4 sm:p-5 shadow-sm">
        <details class="group lg:open" open>
          <summary class="flex items-center justify-between cursor-pointer list-none font-heading text-sm font-black text-ink dark:text-white">
            <span class="flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-moss dark:bg-emerald-400"></span>
              全页章节目录 (TOC)
            </span>
            <span class="text-xs text-muted lg:hidden group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <nav aria-label="页内章节导航" class="mt-3 pt-3 border-t border-line/60 dark:border-white/10">
            <ul class="space-y-2 text-xs">
              {guideData.toc.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class="block py-1 px-2 rounded-lg text-muted hover:text-moss dark:hover:text-emerald-300 hover:bg-moss/5 dark:hover:bg-white/5 transition-colors leading-snug"
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-4 pt-3 border-t border-line/60 dark:border-white/10 space-y-1.5">
              <div class="text-[11px] font-bold text-ink dark:text-white">关联专题快链</div>
              <div class="flex flex-wrap gap-1.5 text-[11px]">
                <a href="/brands" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">42家品牌库</a>
                <a href="/speedtest" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">16份测速原图</a>
                <a href="/ranking" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">Top10榜单</a>
                <a href="/clients" class="rounded bg-paper dark:bg-white/10 px-2 py-1 text-moss dark:text-emerald-300 hover:underline">客户端下载</a>
              </div>
            </div>
          </nav>
        </details>
      </aside>

      <!-- Right Primary Article Column -->
      <article class="lg:col-span-9 space-y-10 min-w-0">

        <!-- Module 0: Direct Answer Box (核心结论前置) -->
        <section id="direct-answer" class="scroll-mt-24 rounded-2xl border-2 border-moss/40 dark:border-emerald-500/40 bg-emerald-50/50 dark:bg-[#0d2625] p-5 sm:p-8 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 rounded-md bg-moss px-2.5 py-1 text-[11px] font-bold text-white uppercase tracking-wider">
              ⚡ 核心结论前置 · 3 分钟看懂怎么选与怎么排障
            </span>
            <span class="text-[11px] font-mono text-muted">Direct Engineering Answer</span>
          </div>

          <p class="text-xs sm:text-sm text-ink dark:text-white font-medium leading-relaxed mb-5">
            {guideData.directAnswer.summary}
          </p>

          <div class="space-y-4">
            {guideData.directAnswer.points.map((pt) => (
              <div class="rounded-xl border border-moss/20 dark:border-white/10 bg-white/90 dark:bg-black/25 p-4 sm:p-5">
                <h2 class="font-heading text-sm sm:text-base font-black text-moss dark:text-emerald-300 mb-2">
                  {pt.label}
                </h2>
                <p class="text-xs sm:text-sm text-muted leading-relaxed">
                  {pt.content}
                </p>
              </div>
            ))}
          </div>

          <!-- Quick Jump Pills -->
          <div class="mt-5 pt-4 border-t border-moss/20 dark:border-white/10">
            <div class="text-xs font-bold text-ink dark:text-white mb-2.5">按您的当前任务一键直达核心板块：</div>
            <div class="flex flex-wrap gap-2">
              {guideData.directAnswer.quickNav.map((nav) => (
                <a
                  href={nav.href}
                  class="inline-flex items-center gap-1 rounded-lg border border-moss/30 bg-white dark:bg-white/10 px-3 py-1.5 text-xs font-semibold text-moss dark:text-emerald-300 hover:bg-moss hover:text-white transition-colors"
                >
                  <span>→</span>
                  <span>{nav.text}</span>
                </a>
              ))}
            </div>
          </div>
        </section>

        <!-- Chapter 1: Network Topology & Table 1 -->
        <section id={guideData.chapters.chapter1.id} class="scroll-mt-24 rounded-2xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-5 sm:p-8 space-y-6">
          <div>
            <span class="text-xs font-bold text-moss dark:text-coral-bright uppercase tracking-wider">{guideData.chapters.chapter1.badge}</span>
            <h2 class="font-heading text-xl sm:text-3xl font-black text-ink dark:text-white mt-1">
              {guideData.chapters.chapter1.title}
            </h2>
            <p class="mt-3 text-xs sm:text-sm text-muted leading-relaxed">
              {guideData.chapters.chapter1.intro}
            </p>
          </div>

          <!-- Visual Topology Diagram -->
          <div class="rounded-xl border border-line/80 dark:border-white/10 bg-paper/50 dark:bg-black/30 p-4 sm:p-6">
            <div class="text-xs font-bold text-ink dark:text-white mb-4 flex items-center justify-between flex-wrap gap-2">
              <span>图 1-1：IEPL / IPLC 专线机场“三段式”跨境网络拓扑结构示意</span>
              <span class="text-[11px] font-mono text-moss dark:text-emerald-300">不过公网 GFW · 晚高峰零拥塞</span>
            </div>
            <div class="overflow-x-auto pb-2">
              <div class="flex flex-col items-center space-y-3 min-w-[480px] font-mono text-xs text-ink dark:text-white">
                <div class="w-full max-w-md rounded-lg border-2 border-moss bg-moss/10 px-4 py-2.5 font-bold text-moss dark:text-emerald-300 text-center">
                  📱 第一跳起点：用户本地设备（手机 / PC / OpenWrt 软路由）
                  <div class="text-[11px] text-muted font-sans font-normal mt-0.5">运行 Clash Verge Rev (Mihomo) / v2rayNG / Shadowrocket 客户端</div>
                </div>
                <div class="text-muted text-[11px]">↓ 境内运营商宽带接入（5ms–20ms，VLESS / Shadowsocks 加密）</div>
                <div class="w-full max-w-md rounded-lg border border-line dark:border-white/20 bg-white dark:bg-[#102a2b] px-4 py-2.5 text-center">
                  🏢 第一跳终点：国内多线 BGP 中转入口机房（深圳 / 广州 / 上海 / 江苏）
                  <div class="text-[11px] text-muted font-sans font-normal mt-0.5">隐藏境外真实落地 IP · 电信/联通/移动三网同运营商就近入场</div>
                </div>
                <div class="w-full max-w-lg rounded-md bg-emerald-500/15 border border-emerald-500/40 py-2 px-3 text-center text-emerald-700 dark:text-emerald-300 font-bold text-[11px]">
                  ⚡ 第二跳核心：[ IEPL 二层以太网专线 / IPLC 物理点对点内网光纤 ] 穿墙过境（完全隔离公网 GFW 与国际出口拥堵）
                </div>
                <div class="w-full max-w-md rounded-lg border border-line dark:border-white/20 bg-white dark:bg-[#102a2b] px-4 py-2.5 text-center">
                  🌐 第三跳枢纽：境外落地机房与 IXP 交换中心（香港 HKIX / 新加坡 / 日本 / 美西）
                  <div class="text-[11px] text-muted font-sans font-normal mt-0.5">本土 ISP 原生住宅 IP 或商业大带宽机房 + DNS 媒体分流解锁宿主机</div>
                </div>
                <div class="text-muted text-[11px]">↓ 纯净海外出口请求（0 丢包直达目标 ASN）</div>
                <div class="w-full max-w-md rounded-lg border border-coral bg-coral/10 px-4 py-2.5 font-bold text-coral dark:text-coral-bright text-center">
                  🚀 目标生产力与娱乐平台（ChatGPT / Claude / Netflix 4K / Disney+ / YouTube 8K）
                </div>
              </div>
            </div>
          </div>

          <!-- Subsections of Chapter 1 -->
          <div class="space-y-6">
            {guideData.chapters.chapter1.subsections.map((sub) => (
              <div id={sub.id} class="space-y-3 pt-2">
                <h3 class="font-heading text-base sm:text-xl font-bold text-ink dark:text-white border-l-4 border-moss pl-3">
                  {sub.title}
                </h3>
                {sub.paragraphs.map((p) => (
                  <p class="text-xs sm:text-sm text-muted leading-relaxed" set:html={formatInlineMarkdown(p)} />
                ))}
              </div>
            ))}
          </div>

          <!-- Table 1: Architecture Comparison Table -->
          <div class="pt-4">
            <div class="text-xs font-bold text-ink dark:text-white mb-2">
              {guideData.architectureComparisonTable.caption}
            </div>
            <div class="overflow-x-auto rounded-xl border border-line dark:border-white/10">
              <table class="w-full text-xs text-left border-collapse min-w-[760px]">
                <thead class="bg-paper dark:bg-black/40 border-b border-line dark:border-white/10 text-ink dark:text-white font-bold">
                  <tr>
                    {guideData.architectureComparisonTable.headers.map((h) => (
                      <th class="py-3 px-3 whitespace-nowrap">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-line/50 dark:divide-white/10">
                  {guideData.architectureComparisonTable.rows.map((r) => (
                    <tr class="hover:bg-paper/40 dark:hover:bg-white/5">
                      <td class="py-3 px-3 font-bold text-moss dark:text-emerald-300 whitespace-nowrap">{r.type}</td>
                      <td class="py-3 px-3 text-muted min-w-[180px]">{r.path}</td>
                      <td class="py-3 px-3 font-semibold">{r.passGfw}</td>
                      <td class="py-3 px-3 text-muted min-w-[150px]">{r.peakPerf}</td>
                      <td class="py-3 px-3 font-mono text-[11px] whitespace-nowrap">{r.latency}</td>
                      <td class="py-3 px-3 font-semibold">{r.survival}</td>
                      <td class="py-3 px-3 font-mono text-[11px]">{r.cost}</td>
                      <td class="py-3 px-3 text-muted min-w-[150px]">{r.scenario}</td>
                      <td class="py-3 px-3 text-ink dark:text-white font-medium min-w-[140px]">{r.brands}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="mt-2 text-[11px] text-muted">
              💡 手机端提示：在 375px 小屏设备上可左右滑动上方表格查看完整 9 项工程指标与代表品牌。想直接查看全部 42 家品牌的架构归类，可访问 <a href="/brands" class="text-moss dark:text-emerald-300 underline">42 家机场品牌大全</a>。
            </p>
          </div>
        </section>

        <!-- Chapter 2: 4-Step Verification of Dedicated Lines -->
        <section id={guideData.chapters.chapter2.id} class="scroll-mt-24 rounded-2xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-5 sm:p-8 space-y-6">
          <div>
            <span class="text-xs font-bold text-moss dark:text-coral-bright uppercase tracking-wider">{guideData.chapters.chapter2.badge}</span>
            <h2 class="font-heading text-xl sm:text-3xl font-black text-ink dark:text-white mt-1">
              {guideData.chapters.chapter2.title}
            </h2>
            <p class="mt-3 text-xs sm:text-sm text-muted leading-relaxed">
              {guideData.chapters.chapter2.intro}
            </p>
          </div>

          <div class="grid grid-cols-1 gap-4">
            {guideData.chapters.chapter2.steps.map((step) => (
              <div class="rounded-xl border border-line/80 dark:border-white/10 bg-paper/40 dark:bg-black/20 p-4 sm:p-6 space-y-2.5">
                <div class="flex items-center gap-2">
                  <span class="rounded bg-moss px-2 py-0.5 font-mono text-[11px] font-bold text-white">{step.stepNum}</span>
                  <h3 class="font-heading text-base sm:text-lg font-bold text-ink dark:text-white">{step.title}</h3>
                </div>
                <p class="text-xs sm:text-sm text-muted leading-relaxed" set:html={formatInlineMarkdown(step.whatAndWhen)} />
                <p class="text-xs sm:text-sm text-ink dark:text-white/90 leading-relaxed" set:html={formatInlineMarkdown(step.howToOperate)} />
                <div class="rounded-lg bg-moss/10 dark:bg-emerald-950/50 border border-moss/20 p-3 text-xs text-moss dark:text-emerald-200 leading-relaxed" set:html={formatInlineMarkdown(step.criteria)} />
              </div>
            ))}
          </div>
        </section>

        <!-- Chapter 3: Proxy Protocols Comparison & Table 2 -->
        <section id={guideData.chapters.chapter3.id} class="scroll-mt-24 rounded-2xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-5 sm:p-8 space-y-6">
          <div>
            <span class="text-xs font-bold text-moss dark:text-coral-bright uppercase tracking-wider">{guideData.chapters.chapter3.badge}</span>
            <h2 class="font-heading text-xl sm:text-3xl font-black text-ink dark:text-white mt-1">
              {guideData.chapters.chapter3.title}
            </h2>
            <p class="mt-3 text-xs sm:text-sm text-muted leading-relaxed">
              {guideData.chapters.chapter3.intro}
            </p>
          </div>

          <div class="space-y-6">
            {guideData.chapters.chapter3.subsections.map((sub) => (
              <div id={sub.id} class="space-y-3 pt-2">
                <h3 class="font-heading text-base sm:text-xl font-bold text-ink dark:text-white border-l-4 border-moss pl-3">
                  {sub.title}
                </h3>
                {sub.paragraphs.map((p) => (
                  <p class="text-xs sm:text-sm text-muted leading-relaxed" set:html={formatInlineMarkdown(p)} />
                ))}
              </div>
            ))}
          </div>

          <!-- Table 2: Protocol Comparison Table -->
          <div class="pt-4">
            <div class="text-xs font-bold text-ink dark:text-white mb-2">
              {guideData.protocolComparisonTable.caption}
            </div>
            <div class="overflow-x-auto rounded-xl border border-line dark:border-white/10">
              <table class="w-full text-xs text-left border-collapse min-w-[820px]">
                <thead class="bg-paper dark:bg-black/40 border-b border-line dark:border-white/10 text-ink dark:text-white font-bold">
                  <tr>
                    {guideData.protocolComparisonTable.headers.map((h) => (
                      <th class="py-3 px-3 whitespace-nowrap">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-line/50 dark:divide-white/10">
                  {guideData.protocolComparisonTable.rows.map((r) => (
                    <tr class="hover:bg-paper/40 dark:hover:bg-white/5">
                      <td class="py-3 px-3 font-bold text-moss dark:text-emerald-300 whitespace-nowrap">{r.name}</td>
                      <td class="py-3 px-3 text-muted min-w-[160px]">{r.layer}</td>
                      <td class="py-3 px-3 text-muted min-w-[130px]">{r.overhead}</td>
                      <td class="py-3 px-3 font-semibold min-w-[130px]">{r.antiBlock}</td>
                      <td class="py-3 px-3 text-muted min-w-[130px]">{r.dedicatedFit}</td>
                      <td class="py-3 px-3 text-muted min-w-[120px]">{r.battery}</td>
                      <td class="py-3 px-3 text-muted min-w-[160px]">{r.compat}</td>
                      <td class="py-3 px-3 text-ink dark:text-white min-w-[180px]">{r.conclusion}</td>
                      <td class="py-3 px-3 text-muted min-w-[140px]">{r.brands}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- Chapter 4: Streaming 4K & AI Unlock Mechanism + Table 3 -->
        <section id={guideData.chapters.chapter4.id} class="scroll-mt-24 rounded-2xl border border-line dark:border-white/10 bg-white dark:bg-[#102a2b] p-5 sm:p-8 space-y-6">
          <div>
            <span class="text-xs font-bold text-moss dark:text-coral-bright uppercase tracking-wider">{guideData.chapters.chapter4.badge}</span>
            <h2 class="font-heading text-xl sm:text-3xl font-black text-ink dark:text-white mt-1">
              {guideData.chapters.chapter4.title}
            </h2>
            <p class="mt-3 text-xs sm:text-sm text-muted leading-relaxed">
              {guideData.chapters.chapter4.intro}
            </p>
          </div>

          <div class="space-y-6">
            {guideData.chapters.chapter4.subsections.map((sub) => (
              <div id={sub.id} class="space-y-3 pt-2">
                <h3 class="font-heading text-base sm:text-xl font-bold text-ink dark:text-white border-l-4 border-moss pl-3">
                  {sub.title}
                </h3>
                {sub.paragraphs.map((p) => (
                  <p class="text-xs sm:text-sm text-muted leading-relaxed" set:html={formatInlineMarkdown(p)} />
                ))}
              </div>
            ))}
          </div>

          <!-- Table 3: Unlock Matrix Table -->
          <div class="pt-4">
            <div class="text-xs font-bold text-ink dark:text-white mb-2">
              {guideData.unlockMatrixTable.caption}
            </div>
            <div class="overflow-x-auto rounded-xl border border-line dark:border-white/10">
              <table class="w-full text-xs text-left border-collapse min-w-[760px]">
                <thead class="bg-paper dark:bg-black/40 border-b border-line dark:border-white/10 text-ink dark:text-white font-bold">
                  <tr>
                    {guideData.unlockMatrixTable.headers.map((h) => (
                      <th class="py-3 px-3 whitespace-nowrap">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-line/50 dark:divide-white/10">
                  {guideData.unlockMatrixTable.rows.map((r) => (
